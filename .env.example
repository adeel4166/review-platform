# Local-development template. Copy to .env (scripts/local-up.sh does this). NEVER commit real secrets.
# The values below are throwaway defaults for the docker-compose services only.

NODE_ENV=development

# MySQL 8 (docker-compose service "mysql")
DATABASE_URL=mysql://app:app_local_pw@127.0.0.1:3306/review_platform

# Redis 7 for BullMQ + rate limits (docker-compose service "redis")
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible storage (MinIO locally; Cloudflare R2 in deployed envs). Buckets per ADR-0006.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio_local
S3_SECRET_ACCESS_KEY=minio_local_secret
S3_BUCKET_INGEST=rp-ingest
S3_BUCKET_PRIVATE=rp-private
S3_BUCKET_PUBLIC=rp-public

# Worker
WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=2000

# Moderation AI provider ("mock" = offline deterministic). Real provider keys: env only, never commit.
MODERATION_PROVIDER=mock
# MODERATION_API_KEY=

# Auth.js (apps/web). Generate a real value with: openssl rand -base64 32  (never commit it)
AUTH_SECRET=replace-me-with-a-random-32-byte-secret
AUTH_TRUST_HOST=true

# Optional: seed passwords (packages/db seed generates and prints random ones if unset)
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# Rate limits and quotas (SEC-03). Defaults shown; Redis-backed fixed windows, 429 + Retry-After.
# RATE_LIMIT_ENABLED=true
# RATE_LOGIN_PER_MIN=5            # per client IP + email
# RATE_LOGIN_PER_HOUR=20
# RATE_REGISTER_PER_HOUR=5        # per client IP
# RATE_REVIEW_USER_PER_HOUR=10    # review create + edit, per user
# RATE_REVIEW_USER_PER_DAY=30
# RATE_REVIEW_IP_PER_HOUR=30
# RATE_UPLOAD_SLOTS_PER_HOUR=20   # per user
# MEDIA_DAILY_QUOTA=50            # upload slots per user per rolling 24 h, FAILED/expired included
# Client IP: number of reverse proxies WE operate in front of the app. The client IP is the Nth entry from the
# right of CLIENT_IP_HEADER, so forged left-hand entries are ignored. 0 = trust no header (all callers share one bucket).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=x-forwarded-for
# UPLOAD_SWEEP_INTERVAL_MS=60000

# Mail (ADR-0016). Only the worker sends mail. Dev: Mailpit (docker-compose), UI at http://localhost:8025.
# Tests use MAIL_PROVIDER=fake (in-memory; refused when NODE_ENV=production). Production needs a TLS relay URL (a secret).
MAIL_PROVIDER=smtp
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Review Platform <no-reply@localhost>
# Base URL for links in emails. Never derived from the request Host header.
APP_URL=http://localhost:3000

# 2FA secrets (m3b-spec 2.10). Keep apart from database backups. NEVER commit real values.
# TOTP_ENC_KEYS is JSON {"keyId":"<base64 of 32 random bytes>"}; generate a key with: openssl rand -base64 32
# TOTP_ENC_KEYS=
# TOTP_ENC_ACTIVE_KEY_ID=
# RECOVERY_CODE_PEPPERS is JSON {"keyId":"<base64 of 32 random bytes>"}
# RECOVERY_CODE_PEPPERS=
# RECOVERY_CODE_ACTIVE_KEY_ID=

# M5 media pipeline (ClamAV, publication)
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/rp-public
# true in production/CI: exiftool must exist or processing fails closed (dev may fall back to a sharp-only check)
MEDIA_EXIFTOOL_REQUIRED=false
# worker /healthz (ClamAV freshness, INF-003); unset = no health server
# WORKER_HEALTH_PORT=9464

# Keyed hash for client IPs stored on votes/reports (SEC-M4-01). REQUIRED: web and worker refuse to start without it (no default).
# Use at least 32 random characters; generate with: openssl rand -base64 32. NEVER commit a real value.
# IP_HASH_KEY=

# M8 (ADR-0033, OPS-001/004): non-secret names only; values come from the secret store
LOG_SCRUB=on
PROOF_ORIGINAL_RETENTION=AT_DECISION
S3_BUCKET_LEDGER=rp-ledger
S3_BUCKET_AUDIT_ARCHIVE=rp-audit-archive
SECURITY_ALERT_EMAIL=

# Demo seed (pnpm db:seed:demo; refuses NODE_ENV/APP_ENV=production). Password for the six demo role accounts, >= 12 chars. Env only, never commit.
# DEMO_PASSWORD=
