// =============================================================================
// Review Platform: Phase 1 data model (DRAFT)
// =============================================================================
// Status   : DRAFT. Task #18 (M1.1), revised by #19 (M1.2) and #24 (M1-T1).
//            Feature tasks adopt it table-by-table, with migrations, into
//            packages/db/prisma/schema.prisma (which holds only OutboxEvent today).
// Target   : Prisma ORM 6.x (scaffold pins 6.19), MySQL 8.0.16+ (InnoDB, utf8mb4).
// Checked  : `prisma validate` and `prisma format --check` pass on Prisma 6.19.3.
// Docs     : docs/architecture/data-model.md  (ERD, lifecycles, rules)
//            docs/adr/0004-data-model-conventions.md
//            docs/architecture/check-constraints.sql (exclusive-arc CHECKs)
//
// Scope    : Phase 1 only. MESSAGING (DMs, conversations, seller-buyer chat)
//            IS OUT OF SCOPE. There are deliberately no Conversation/Message
//            tables and no message-related enum values. See data-model.md §1.
//
// Markers  : "OPEN(LEGAL)" and "OPEN(LANG)" mark fields whose final shape
//            depends on unresolved questions in docs/architecture/open-questions.md.
//
// Conventions (summary; full rationale in ADR-0004):
//  - IDs are cuid strings. AuditLog and OutboxEvent use BIGINT autoincrement.
//  - All timestamps are UTC DATETIME(3).
//  - User content is never hard-deleted by the app: status + deletedAt.
//    Physical purge is done by retention jobs only.
//  - "Exclusive arc" tables (one row targets exactly one of N parents) use
//    nullable FKs with onDelete/onUpdate: Restrict, plus a CHECK constraint
//    added in raw SQL. MySQL forbids CHECKs on columns with CASCADE/SET NULL
//    actions, which is why the arcs use Restrict.
//  - Counters (helpfulCount, likeCount...) are denormalized caches maintained
//    by the worker. The rows are the source of truth.
//  - Physical names (ADR-0010): every model maps to a lowercase snake_case
//    plural table via @@map. Fields keep their camelCase names as columns.
//  - Worker/outbox: ADR-0007. Verified buyer: ADR-0008. i18n: ADR-0009.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED // projection of an active SUSPENSION EnforcementAction
  BANNED // projection of an active BAN EnforcementAction
  DEACTIVATED // user-initiated, reversible
  DELETED // erasure processed; row kept as anonymized tombstone
}

/// Global staff roles. "USER" is implicit (any active account) and not stored.
enum PlatformRole {
  MODERATOR
  SENIOR_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum OAuthProvider {
  GOOGLE
  APPLE // OPEN: Apple sign-in not yet confirmed for Phase 1
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  CONTENT_POLICY
  SELLER_TERMS
}

enum SellerStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  CLOSED
}

enum SellerMemberRole {
  OWNER
  MANAGER
  RESPONDER
}

enum OwnershipClaimScope {
  SELLER // prove control of the business/brand itself
  PRODUCT // claim an existing, unclaimed product listing for a verified seller
}

enum OwnershipProofMethod {
  DNS_TXT_RECORD
  WEBSITE_META_TAG
  BUSINESS_EMAIL_DOMAIN
  DOCUMENT_UPLOAD
  MARKETPLACE_STORE_LINK
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  REVOKED
}

enum ProductStatus {
  PENDING // user-submitted, awaiting moderation
  ACTIVE
  MERGED // duplicate; see mergedIntoId
  ARCHIVED
  REMOVED
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/// Shared lifecycle for user-generated content (reviews, replies, comments, posts).
enum ContentStatus {
  PENDING // awaiting AI and/or human moderation; visible to author only
  PUBLISHED
  HIDDEN // UNSURE verdict / restricted: held for staff decision (7-day hold); author + staff only
  REJECTED // blocked BEFORE ever being public (VIOLATION or hold expired); appealable. M1.2
  REMOVED // taken down AFTER being public; visible to author + staff (statement of reasons)
  DELETED // author deleted (soft); retained for evidence until purge
}

/// Incentive disclosure on reviews. OPEN(LEGAL): exact policy per jurisdiction.
enum IncentiveDisclosure {
  NONE
  FREE_PRODUCT
  DISCOUNT
  PAYMENT
  OTHER
}

enum PurchaseProofMethod {
  RECEIPT_UPLOAD
  ORDER_CONFIRMATION
  MARKETPLACE_ORDER_LINK
}

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED // never decided within SLA, or retention-expired before decision
  WITHDRAWN // user withdrew/deleted proof before decision
}

enum VoteValue {
  HELPFUL
  NOT_HELPFUL
}

enum MediaPurpose {
  AVATAR
  SELLER_LOGO
  PRODUCT_IMAGE
  REVIEW_MEDIA
  POST_MEDIA
  PURCHASE_PROOF
  OWNERSHIP_EVIDENCE
  APPEAL_EVIDENCE
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

/// PUBLIC -> public bucket behind CDN. PRIVATE -> private bucket, short-lived signed URLs only.
enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  UPLOADING // presigned URL issued, not yet confirmed
  PROCESSING // worker: metadata strip, transcode, redaction, AI scan
  READY
  REJECTED // failed moderation / validation
  FAILED // processing error
  PURGED // object deleted from storage; row kept as tombstone
}

/// Bucket the asset's objects currently live in (media-pipeline.md §5). M1.2
enum StorageBucket {
  INGEST // raw, untrusted upload
  PRIVATE // processed but not public, evidence, quarantine
  PUBLIC // published via CDN
}

/// Why an asset is REJECTED or FAILED (media-pipeline.md §4).
enum MediaFailureReason {
  TYPE_NOT_ALLOWED
  TYPE_MISMATCH
  TOO_LARGE
  TOO_LONG
  TOO_MANY_PIXELS
  UNSUPPORTED_CODEC
  CORRUPT
  MALWARE
  BANNED_HASH
  POLICY_VIOLATION // standalone media moderated as VIOLATION
  NOT_CONFIRMED // upload slot never confirmed
  SCAN_UNAVAILABLE // FAILED: scanner down beyond retry budget (fail closed)
  PROCESSING_ERROR // FAILED
}

enum MediaProcessingStep {
  SLOT_ISSUED
  UPLOAD_CONFIRMED
  VALIDATE
  VIRUS_SCAN
  SANITIZE // EXIF/GPS/XMP strip + verification
  TRANSCODE
  VARIANTS
  AI_MODERATION
  PROMOTE
  DEMOTE
  QUARANTINE
  PURGE
}

enum MediaProcessingOutcome {
  OK
  REJECTED
  INFECTED
  ERROR
  SKIPPED
}

enum ReportReason {
  SPAM
  FAKE_OR_MISLEADING
  CONFLICT_OF_INTEREST
  OFF_TOPIC
  HARASSMENT_OR_HATE
  SEXUAL_CONTENT
  VIOLENCE_OR_THREATS
  PERSONAL_INFORMATION
  INTELLECTUAL_PROPERTY
  ILLEGAL_CONTENT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  NO_ACTION
  REJECTED // invalid/abusive report (feeds reporter trust signal)
}

enum ModerationTrigger {
  SUBMISSION
  EDIT
  USER_REPORT
  AI_RESCAN
  STAFF_INITIATED
  APPEAL
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  RESOLVED
}

enum DecisionSource {
  AI
  HUMAN
  RULE // deterministic rule (blocklist, velocity limit, duplicate hash)
}

enum DecisionOutcome {
  APPROVE
  RESTRICT // -> ContentStatus.HIDDEN
  REMOVE // -> ContentStatus.REMOVED
  ESCALATE // AI/rule not confident -> human queue
}

/// AI/rule verdict (moderation-pipeline.md §2). CLEAN -> APPROVE, VIOLATION -> REMOVE, UNSURE -> ESCALATE.
enum ModerationVerdict {
  CLEAN
  VIOLATION
  UNSURE // includes AI provider failure
}

/// Staff work-queue lane of a ModerationCase (moderation-pipeline.md §6.1).
enum ModerationLane {
  POST_REVIEW // CLEAN and live; human post-review due within 24 h
  HOLD // UNSURE and hidden; auto-reject at holdExpiresAt (7 days)
  REPORTED // live content with reports / staff flags
}

/// Moderation state of one ReviewRevision (edits of live reviews, moderation-pipeline.md §3.3).
enum RevisionStatus {
  PENDING
  HELD
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ModerationConfigStatus {
  DRAFT
  ACTIVE // exactly one (application rule)
  SHADOW // at most one; evaluated for metrics only
  RETIRED
}

enum EnforcementType {
  WARNING
  CONTENT_REMOVAL
  POSTING_RESTRICTION
  VOTING_RESTRICTION
  VERIFIED_LABEL_REVOKED
  SUSPENSION
  BAN
  SELLER_REPLY_RESTRICTION
  SELLER_SUSPENSION
}

enum EnforcementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  OVERTURNED // via appeal
}

enum AppealStatus {
  SUBMITTED
  IN_REVIEW
  UPHELD // original decision stands
  OVERTURNED
  PARTIALLY_OVERTURNED
  WITHDRAWN
}

/// Event-like trust inputs. State-like inputs (account age, 2FA on, seller
/// verified) are read directly at scoring time and are not stored as signals.
enum TrustSignalType {
  VERIFIED_PURCHASE
  REVIEW_PUBLISHED
  REVIEW_REMOVED
  HELPFUL_VOTE_RECEIVED
  NOT_HELPFUL_VOTE_RECEIVED
  REPORT_UPHELD // reporter was right
  REPORT_REJECTED // reporter was wrong/abusive
  CONTENT_ACTIONED_AGAINST // subject's content removed/restricted
  ENFORCEMENT_ACTION
  APPEAL_OVERTURNED
  SELLER_REPLY_PUBLISHED
  SELLER_REPLY_REMOVED
  VELOCITY_ANOMALY
  DUPLICATE_PROOF_DETECTED
  LINKED_ACCOUNT_SUSPECTED
  MALWARE_UPLOAD // M1.2: upload rejected by virus scan
}

enum TrustBand {
  NEW
  LOW
  MEDIUM
  HIGH
}

/// No messaging types in Phase 1 (Messaging is out of scope).
enum NotificationType {
  REVIEW_PUBLISHED
  // Moderation outcomes for any content type (M1.2; replaces REVIEW_REJECTED / REVIEW_HIDDEN).
  // All CONTENT_*, MEDIA_REJECTED and APPEAL_RECEIVED are mandatory (statement of reasons).
  CONTENT_HELD
  CONTENT_REJECTED
  CONTENT_REMOVED
  CONTENT_RESTORED
  MEDIA_REJECTED
  APPEAL_RECEIVED
  REVIEW_VOTED_HELPFUL
  SELLER_REPLIED
  REVIEW_COMMENTED
  POST_COMMENTED
  COMMENT_REPLIED
  POST_LIKED
  COMMENT_LIKED
  NEW_FOLLOWER
  FOLLOWED_PRODUCT_REVIEWED
  FOLLOWED_SELLER_POSTED
  FOLLOWED_USER_POSTED
  PROOF_VERIFIED
  PROOF_REJECTED
  CLAIM_VERIFIED
  CLAIM_REJECTED
  SELLER_MEMBER_INVITED
  REPORT_RESOLVED
  ENFORCEMENT_ISSUED // mandatory; cannot be disabled
  APPEAL_DECIDED // mandatory; cannot be disabled
  SECURITY_ALERT // mandatory; new login, 2FA/password/email changed
  SYSTEM_ANNOUNCEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum AuditActorType {
  USER
  STAFF
  SYSTEM
  AI
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique // normalized lowercase
  emailVerifiedAt DateTime?
  passwordHash    String?    @db.VarChar(255) // Argon2id; null for OAuth-only accounts
  handle          String     @unique @db.VarChar(32)
  displayName     String     @db.VarChar(64)
  bio             String?    @db.Text
  avatarMediaId   String?    @unique
  locale          String?    @db.VarChar(16) // ADR-0009: BCP 47 tag; null = negotiate (cookie, Accept-Language, then 'en')
  timeZone        String?    @db.VarChar(64) // ADR-0009: IANA zone for emails; null = UTC (UI uses the browser zone)
  status          UserStatus @default(ACTIVE)
  trustScore      Decimal?   @db.Decimal(5, 2) // cache of latest TrustScoreSnapshot (internal only)
  lastLoginAt     DateTime?
  deactivatedAt   DateTime?
  anonymizedAt    DateTime? // OPEN(LEGAL): erasure = anonymize tombstone, see open-questions
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  avatar MediaAsset? @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  oauthAccounts       OAuthAccount[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  totp                TwoFactorTotp?
  recoveryCodes       RecoveryCode[]
  webAuthnCredentials WebAuthnCredential[]
  roles               UserRole[]           @relation("UserRoles")
  rolesGranted        UserRole[]           @relation("RoleGrantedBy")
  legalAcceptances    LegalAcceptance[]

  uploads MediaAsset[] @relation("MediaOwner")

  sellerMemberships        SellerMember[]         @relation("SellerMembership")
  sellerInvitesSent        SellerMember[]         @relation("SellerMemberInvitedBy")
  sellersCreated           Seller[]               @relation("SellerCreatedBy")
  ownershipClaimsSubmitted SellerOwnershipClaim[] @relation("ClaimSubmittedBy")
  ownershipClaimsReviewed  SellerOwnershipClaim[] @relation("ClaimReviewedBy")
  productsCreated          Product[]              @relation("ProductCreatedBy")

  reviews                 Review[]         @relation("ReviewAuthor")
  reviewRevisionsEdited   ReviewRevision[] @relation("RevisionEditor")
  purchaseProofsSubmitted PurchaseProof[]  @relation("ProofSubmittedBy")
  purchaseProofsReviewed  PurchaseProof[]  @relation("ProofReviewedBy")
  reviewVotes             ReviewVote[]
  sellerRepliesAuthored   SellerReply[]    @relation("ReplyAuthor")

  posts         Post[]         @relation("PostAuthor")
  comments      Comment[]      @relation("CommentAuthor")
  likes         Like[]
  following     Follow[]       @relation("FollowFollower")
  followers     Follow[]       @relation("FollowFollowedUser")
  blocking      UserBlock[]    @relation("BlockBlocker")
  blockedBy     UserBlock[]    @relation("BlockBlocked")
  wishlistItems WishlistItem[]
  comparisons   Comparison[]

  reportsFiled            Report[]             @relation("ReportReporter")
  reportsAgainst          Report[]             @relation("ReportReportedUser")
  moderationCasesAbout    ModerationCase[]     @relation("CaseTargetUser")
  moderationCasesAssigned ModerationCase[]     @relation("CaseAssignee")
  moderationDecisions     ModerationDecision[] @relation("DecisionModerator")
  enforcementsReceived    EnforcementAction[]  @relation("EnforcementSubjectUser")
  enforcementsIssued      EnforcementAction[]  @relation("EnforcementIssuedBy")
  enforcementsRevoked     EnforcementAction[]  @relation("EnforcementRevokedBy")
  appealsFiled            Appeal[]             @relation("AppealAppellant")
  appealsReviewed         Appeal[]             @relation("AppealReviewer")
  trustSignals            TrustSignal[]        @relation("TrustSignalUser")
  trustScores             TrustScoreSnapshot[] @relation("TrustScoreUser")

  notificationsReceived   Notification[]           @relation("NotificationRecipient")
  notificationsActed      Notification[]           @relation("NotificationActor")
  notificationPreferences NotificationPreference[]

  @@index([status])
  @@map("users")
}

/// External identity link. We store identity only: no provider access/refresh tokens.
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(191) // OIDC `sub`
  emailAtLink       String?
  createdAt         DateTime      @default(now())
  lastUsedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Server-side session. Cookie holds a random 256-bit token; DB stores SHA-256(token). See ADR-0002.
model Session {
  id                     String    @id @default(cuid())
  userId                 String
  tokenHash              String    @unique @db.Char(64)
  secondFactorPending    Boolean   @default(false) // password OK, TOTP/passkey not yet presented
  secondFactorVerifiedAt DateTime?
  reauthenticatedAt      DateTime? // step-up auth for sensitive actions
  createdAt              DateTime  @default(now())
  lastActiveAt           DateTime  @default(now())
  idleExpiresAt          DateTime
  absoluteExpiresAt      DateTime
  revokedAt              DateTime?
  revokeReason           String?   @db.VarChar(64) // logout, password_reset, enforcement, admin, rotation
  ipHash                 String?   @db.Char(64) // OPEN(LEGAL): keyed hash, never raw IP
  userAgent              String?   @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Single-use tokens sent by email. Only SHA-256(token) is stored.
model VerificationToken {
  id         String              @id @default(cuid())
  userId     String
  purpose    VerificationPurpose
  tokenHash  String              @unique @db.Char(64)
  newEmail   String? // EMAIL_CHANGE target
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// TOTP (RFC 6238). Secret is AES-256-GCM encrypted with an app key (envelope, keyId for rotation).
model TwoFactorTotp {
  id               String    @id @default(cuid())
  userId           String    @unique
  secretCiphertext Bytes     @db.VarBinary(255)
  keyId            String    @db.VarChar(64)
  confirmedAt      DateTime? // null = enrollment started, not yet confirmed
  lastUsedStep     BigInt? // replay protection: reject codes for steps <= this
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_totps")
}

/// One-time recovery codes (high entropy -> SHA-256 is sufficient).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// Passkeys. Stretch goal for Phase 1 (recommended for staff); table reserved now.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique @db.VarChar(512) // base64url
  publicKey    Bytes     @db.VarBinary(1024)
  signCount    Int       @default(0)
  transports   String?   @db.VarChar(128)
  nickname     String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Active staff role grants. Revocation deletes the row; history lives in AuditLog.
model UserRole {
  userId      String
  role        PlatformRole
  grantedById String?
  grantedAt   DateTime     @default(now())
  reason      String?      @db.VarChar(255)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Which version of which legal text a user accepted. OPEN(LEGAL): document set per jurisdiction.
model LegalAcceptance {
  id              String            @id @default(cuid())
  userId          String
  documentType    LegalDocumentType
  documentVersion String            @db.VarChar(32)
  documentLocale  String            @default("en") @db.VarChar(16) // ADR-0009: language version shown and accepted (G-8)
  acceptedAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion])
  @@map("legal_acceptances")
}

// -----------------------------------------------------------------------------
// Sellers & ownership proof
// -----------------------------------------------------------------------------
// SUPERSEDED for M3 by docs/architecture/m3-sellers-spec.md §2 (task #44): final
// Seller / SellerMember / SellerInvitation / SellerOwnershipClaim / SellerClaimDecision /
// EmailVerificationToken models, renamed OwnershipProofMethod values and new ClaimStatus
// values (CONTESTED, WITHDRAWN). The models below are kept as the M1 draft record.

model Seller {
  id                  String       @id @default(cuid())
  slug                String       @unique @db.VarChar(80)
  name                String       @db.VarChar(120)
  description         String?      @db.Text
  websiteUrl          String?      @db.VarChar(2048)
  businessEmailDomain String?      @db.VarChar(255)
  countryCode         String?      @db.Char(2) // OPEN(LEGAL): KYB requirements per country
  logoMediaId         String?      @unique
  status              SellerStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  trustScore          Decimal?     @db.Decimal(5, 2) // cache; seller score is public
  replyRate           Decimal?     @db.Decimal(5, 4) // cache: replied / eligible reviews (0..1)
  createdById         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  logo      MediaAsset? @relation("SellerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  createdBy User        @relation("SellerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  members            SellerMember[]
  ownershipClaims    SellerOwnershipClaim[]
  products           Product[]
  replies            SellerReply[]
  posts              Post[]
  followers          Follow[]
  reports            Report[]
  moderationCases    ModerationCase[]
  enforcementActions EnforcementAction[]
  trustSignals       TrustSignal[]          @relation("TrustSignalSeller")
  trustScores        TrustScoreSnapshot[]   @relation("TrustScoreSeller")

  @@index([status])
  @@map("sellers")
}

/// Membership of a user in a seller organisation (scoped role, see ADR-0003).
/// Invitations: row exists with acceptedAt = null until the invitee accepts.
model SellerMember {
  sellerId    String
  userId      String
  role        SellerMemberRole
  invitedById String?
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User   @relation("SellerMembership", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("SellerMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@id([sellerId, userId])
  @@index([userId])
  @@map("seller_members")
}

/// Proof that a seller controls a business (scope SELLER) or a product listing (scope PRODUCT).
model SellerOwnershipClaim {
  id             String               @id @default(cuid())
  sellerId       String
  scope          OwnershipClaimScope
  productId      String? // required iff scope = PRODUCT (CHECK constraint)
  method         OwnershipProofMethod
  status         ClaimStatus          @default(PENDING)
  challengeValue String?              @db.VarChar(128) // DNS TXT / meta-tag token (not a secret)
  evidenceUrl    String?              @db.VarChar(2048) // marketplace store link etc.
  submittedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  decisionNote   String?              @db.Text
  verifiedUntil  DateTime? // periodic re-verification
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict) // CHECK chk_claim_product_scope
  submittedBy User     @relation("ClaimSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?    @relation("ClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  evidence MediaAsset[] // private bucket, purpose OWNERSHIP_EVIDENCE
  appeals  Appeal[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@map("seller_ownership_claims")
}

// -----------------------------------------------------------------------------
// Catalog & comparison
// -----------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120) // OPEN(LANG): translations
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]

  @@index([parentId, position])
  @@map("categories")
}

/// Spec schema per category; drives comparison tables and validates Product.specs.
model CategoryAttribute {
  id           String            @id @default(cuid())
  categoryId   String
  key          String            @db.VarChar(64)
  label        String            @db.VarChar(120) // OPEN(LANG)
  dataType     AttributeDataType
  unit         String?           @db.VarChar(32)
  options      Json? // allowed values for ENUM
  isComparable Boolean           @default(true)
  position     Int               @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@map("category_attributes")
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(160)
  name          String        @db.VarChar(200) // OPEN(LANG)
  brandName     String?       @db.VarChar(120)
  description   String?       @db.Text
  categoryId    String
  sellerId      String? // owning/verified seller allowed to reply; null = unclaimed
  gtin          String?       @unique @db.VarChar(14)
  mpn           String?       @db.VarChar(64)
  specs         Json? // { [CategoryAttribute.key]: value }, validated in app
  status        ProductStatus @default(PENDING)
  mergedIntoId  String?
  createdById   String
  ratingAverage Decimal?      @db.Decimal(3, 2) // cache
  ratingCount   Int           @default(0) // cache
  reviewCount   Int           @default(0) // cache
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller     Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  mergedInto Product?  @relation("ProductMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Product[] @relation("ProductMerge")
  createdBy  User      @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  images          MediaAsset[]
  reviews         Review[]
  ownershipClaims SellerOwnershipClaim[]
  posts           Post[]
  followers       Follow[]
  wishlistItems   WishlistItem[]
  comparisonItems ComparisonItem[]
  reports         Report[]
  moderationCases ModerationCase[]

  @@index([categoryId, status])
  @@index([sellerId])
  @@index([status, createdAt])
  @@map("products")
}

model Comparison {
  id        String   @id @default(cuid())
  ownerId   String
  title     String?  @db.VarChar(120)
  isPublic  Boolean  @default(false)
  shareSlug String?  @unique @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items ComparisonItem[]

  @@index([ownerId])
  @@map("comparisons")
}

model ComparisonItem {
  comparisonId String
  productId    String
  position     Int    @default(0)

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([comparisonId, productId])
  @@map("comparison_items")
}

// -----------------------------------------------------------------------------
// Reviews, verified-buyer proof, votes, seller replies
// -----------------------------------------------------------------------------

/// One review per (product, author), ever. Edits create ReviewRevision rows and re-enter moderation.
model Review {
  id                 String               @id @default(cuid())
  productId          String
  authorId           String
  rating             Int                  @db.TinyInt // 1..5, CHECK in check-constraints.sql
  title              String               @db.VarChar(150)
  body               String               @db.Text
  incentive          IncentiveDisclosure  @default(NONE) // OPEN(LEGAL)
  language           String?              @db.VarChar(16) // OPEN(LANG): detected BCP 47 tag
  status             ContentStatus        @default(PENDING)
  currentVersion     Int                  @default(1)
  publishedVersion   Int? // revision shown publicly; lags currentVersion while an edit is moderated (M1.2)
  // Verified-buyer label. Kept independent of PurchaseProof files so the label
  // survives proof redaction/deletion (see data-model.md §6.2).
  verifiedPurchaseAt DateTime?
  verificationMethod PurchaseProofMethod?
  verifiedProofId    String?              @unique // ADR-0008: the one PurchaseProof that granted the label
  helpfulCount       Int                  @default(0) // cache
  notHelpfulCount    Int                  @default(0) // cache
  commentCount       Int                  @default(0) // cache
  publishedAt        DateTime?
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  verifiedProof PurchaseProof? @relation("ReviewVerifiedProof", fields: [verifiedProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  revisions       ReviewRevision[]
  proofs          PurchaseProof[]  @relation("ReviewProofs")
  votes           ReviewVote[]
  reply           SellerReply?
  comments        Comment[]
  media           MediaAsset[]
  reports         Report[]
  moderationCases ModerationCase[]

  @@unique([productId, authorId])
  @@index([productId, status, publishedAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@map("reviews")
}

/// Immutable history of review text/rating (evidence for moderation and appeals).
model ReviewRevision {
  id        String         @id @default(cuid())
  reviewId  String
  version   Int
  rating    Int            @db.TinyInt
  title     String         @db.VarChar(150)
  body      String         @db.Text
  editorId  String // author, or staff when redacting PII
  status    RevisionStatus @default(PENDING) // M1.2, moderation-pipeline.md §3.3
  createdAt DateTime       @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  editor User   @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([reviewId, version])
  @@map("review_revisions")
}

/// Verified-buyer evidence. Files live in MediaAsset (PRIVATE). The row itself is a
/// minimal, long-lived provenance record; files are redacted then purged (data-model.md §6.2).
model PurchaseProof {
  id                 String              @id @default(cuid())
  reviewId           String
  submittedById      String
  method             PurchaseProofMethod
  status             ProofStatus         @default(PENDING)
  merchantName       String?             @db.VarChar(120) // extracted, non-PII
  purchaseDate       DateTime?           @db.Date
  orderReferenceHash String?             @db.Char(64) // keyed hash; detects reuse across accounts
  fileFingerprint    String?             @db.Char(64) // SHA-256 of original; kept after purge
  aiAssessment       Json? // extraction + match confidence; MUST NOT contain raw PII
  reviewedById       String?
  reviewedAt         DateTime?
  decisionReason     String?             @db.VarChar(500)
  redactedAt         DateTime? // redacted derivative produced
  originalPurgedAt   DateTime? // original file deleted from storage
  filesPurgedAt      DateTime? // all files (incl. redacted copy) deleted
  retainFilesUntil   DateTime? // OPEN(LEGAL): retention window
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  review      Review @relation("ReviewProofs", fields: [reviewId], references: [id], onDelete: Restrict)
  submittedBy User   @relation("ProofSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?  @relation("ProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  files          MediaAsset[]
  appeals        Appeal[]
  verifiedReview Review?      @relation("ReviewVerifiedProof")

  @@index([status, createdAt])
  @@index([reviewId])
  @@index([orderReferenceHash])
  @@index([fileFingerprint])
  @@index([retainFilesUntil])
  @@map("purchase_proofs")
}

model ReviewVote {
  reviewId  String
  userId    String
  value     VoteValue
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}

/// One public reply per review, on behalf of the product's verified seller.
model SellerReply {
  id          String        @id @default(cuid())
  reviewId    String        @unique
  sellerId    String
  authorId    String // the SellerMember who wrote it
  body        String        @db.Text
  status      ContentStatus @default(PENDING)
  publishedAt DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  author User   @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  reports         Report[]
  moderationCases ModerationCase[]

  @@index([sellerId, createdAt])
  @@map("seller_replies")
}

// -----------------------------------------------------------------------------
// Media (S3/R2 objects)
// -----------------------------------------------------------------------------

/// One row per stored object. Attachment is an exclusive arc (at most one of
/// reviewId/postId/productId/purchaseProofId/ownershipClaimId/appealId);
/// avatars and logos are referenced from User/Seller instead.
model MediaAsset {
  id               String              @id @default(cuid())
  ownerId          String
  purpose          MediaPurpose
  kind             MediaKind
  visibility       MediaVisibility
  status           MediaStatus         @default(UPLOADING)
  bucket           StorageBucket       @default(INGEST) // where the objects currently are (M1.2)
  storageKey       String              @unique @db.VarChar(512) // primary object key in `bucket`; never derived from user input
  mimeType         String              @db.VarChar(127) // declared at slot time
  detectedMimeType String?             @db.VarChar(127) // magic-byte detection (VALIDATE step)
  failureReason    MediaFailureReason? // set when REJECTED / FAILED
  sizeBytes        Int?
  width            Int?
  height           Int?
  durationMs       Int?
  sha256           String?             @db.Char(64)
  perceptualHash   String?             @db.VarChar(32) // near-duplicate detection (images)
  variants         Json? // { thumb: key, medium: key, poster: key, ... }
  altText          String?             @db.VarChar(500)
  metadataStripped Boolean             @default(false) // EXIF/GPS removed
  isRedacted       Boolean             @default(false) // redacted derivative of derivedFromId
  derivedFromId    String?
  legalHold        Boolean             @default(false) // blocks purge jobs
  position         Int                 @default(0)

  // exclusive arc (at most one non-null), Restrict: see check-constraints.sql
  reviewId         String?
  postId           String?
  productId        String?
  purchaseProofId  String?
  ownershipClaimId String?
  appealId         String?

  virusScannedAt DateTime?
  processedAt    DateTime?
  promotedAt     DateTime? // copied to the PUBLIC bucket (null while private)
  purgedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner       User         @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  derivedFrom MediaAsset?  @relation("MediaDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives MediaAsset[] @relation("MediaDerivation")

  review         Review?               @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post           Post?                 @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseProof  PurchaseProof?        @relation(fields: [purchaseProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownershipClaim SellerOwnershipClaim? @relation(fields: [ownershipClaimId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appeal         Appeal?               @relation(fields: [appealId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  avatarOf User?   @relation("UserAvatar")
  logoOf   Seller? @relation("SellerLogo")

  reports         Report[]
  moderationCases ModerationCase[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt]) // orphan cleanup: UPLOADING/READY + unattached + old
  @@index([sha256])
  @@index([perceptualHash])
  @@map("media_assets")
}

// -----------------------------------------------------------------------------
// Social: posts, comments, likes, follows, blocks, wishlist
// -----------------------------------------------------------------------------

model Post {
  id           String        @id @default(cuid())
  authorId     String
  asSellerId   String? // posted on behalf of a seller (requires seller role)
  productId    String? // optional product tag
  body         String        @db.Text
  status       ContentStatus @default(PENDING)
  likeCount    Int           @default(0) // cache
  commentCount Int           @default(0) // cache
  publishedAt  DateTime?
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author   User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  asSeller Seller?  @relation(fields: [asSellerId], references: [id], onDelete: Restrict)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  media           MediaAsset[]
  comments        Comment[]
  likes           Like[]
  reports         Report[]
  moderationCases ModerationCase[]

  @@index([authorId, createdAt])
  @@index([asSellerId, createdAt])
  @@index([status, createdAt])
  @@map("posts")
}

/// Comment on a review OR a post (exclusive arc). One level of threading via parentId.
model Comment {
  id          String        @id @default(cuid())
  authorId    String
  reviewId    String?
  postId      String?
  parentId    String?
  body        String        @db.Text
  status      ContentStatus @default(PENDING)
  likeCount   Int           @default(0) // cache
  publishedAt DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author  User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  review  Review?   @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post    Post?     @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Restrict)
  replies Comment[] @relation("CommentThread")

  likes           Like[]
  reports         Report[]
  moderationCases ModerationCase[]

  @@index([reviewId, createdAt])
  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("comments")
}

/// Like on a post OR a comment (exclusive arc). Reviews use ReviewVote instead.
/// NOTE: LIKE is a MySQL reserved word. Prisma quotes it automatically; raw SQL must use `Like` in backticks.
model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // MySQL unique indexes allow multiple NULLs, so these work with the arc.
  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

/// Follow a user, seller OR product (exclusive arc).
model Follow {
  id                String   @id @default(cuid())
  followerId        String
  followedUserId    String?
  followedSellerId  String?
  followedProductId String?
  createdAt         DateTime @default(now())

  follower        User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followedUser    User?    @relation("FollowFollowedUser", fields: [followedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followedSeller  Seller?  @relation(fields: [followedSellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followedProduct Product? @relation(fields: [followedProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([followerId, followedUserId])
  @@unique([followerId, followedSellerId])
  @@unique([followerId, followedProductId])
  @@map("follows")
}

/// User-to-user block. Blocked users cannot follow, comment on, or like the blocker's content.
/// (Will also gate Phase 2 messaging.)
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// -----------------------------------------------------------------------------
// Trust & safety: reports, moderation, enforcement, appeals
// -----------------------------------------------------------------------------

/// A user's report against exactly one target (exclusive arc). Reports are grouped into a ModerationCase.
model Report {
  id         String       @id @default(cuid())
  reporterId String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(OPEN)
  caseId     String?

  // exclusive arc (exactly one non-null)
  reviewId       String?
  commentId      String?
  postId         String?
  sellerReplyId  String?
  reportedUserId String?
  sellerId       String?
  productId      String?
  mediaAssetId   String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporter       User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  review         Review?         @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comment        Comment?        @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post           Post?           @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerReply    SellerReply?    @relation(fields: [sellerReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportedUser   User?           @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seller         Seller?         @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

/// Unit of moderation work for one target (exclusive arc). AI-first: the AI decision is
/// recorded first; low confidence -> ESCALATE -> human queue. See ADR-0003 and data-model.md §6.1.
model ModerationCase {
  id              String            @id @default(cuid())
  trigger         ModerationTrigger
  status          CaseStatus        @default(OPEN)
  priority        Int               @default(0) // higher = sooner
  assignedToId    String?
  slaDueAt        DateTime?
  outcome         DecisionOutcome? // final outcome once RESOLVED
  resolutionCode  String?           @db.VarChar(64) // e.g. HOLD_EXPIRED, POST_REVIEW_LAPSED, SUPERSEDED, WITHDRAWN_BY_AUTHOR; M1-T2: APPEAL_OVERTURNED, REPORTS_DISMISSED, REPORT_THRESHOLD, RESUBMITTED (moderation-lifecycle.md)
  contentSnapshot Json? // evidence: content as it was when the case opened. OPEN(LEGAL): retention
  contentVersion  Int? // revision under moderation (Review.currentVersion when opened)

  // M1.2 queue fields (moderation-pipeline.md §6). Denormalised from the latest AI/RULE
  // decision by ModerationService.transition() only, for queue sorting/filtering.
  lane            ModerationLane?
  aiVerdict       ModerationVerdict?
  aiScore         Decimal?           @db.Decimal(5, 4) // max category score, 0..1
  aiTopCategory   String?            @db.VarChar(64)
  aiReason        String?            @db.VarChar(500) // one-line reason shown in the queue
  configVersion   String?            @db.VarChar(32) // ModerationConfig.version used
  // Timers: deadlines captured when the timer starts (config changes do not move them).
  holdExpiresAt   DateTime? // lane HOLD: auto-reject at this time (CHECK chk_case_hold_expiry)
  postReviewDueAt DateTime? // lane POST_REVIEW: 24 h SLA (CHECK chk_case_post_review_due)
  appealableUntil DateTime? // set on REJECT/REMOVE decisions
  leaseExpiresAt  DateTime? // claim lease for assignedToId (15 min)

  // exclusive arc (exactly one non-null)
  reviewId      String?
  commentId     String?
  postId        String?
  sellerReplyId String?
  targetUserId  String?
  sellerId      String?
  productId     String?
  mediaAssetId  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  assignedTo  User?        @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  review      Review?      @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comment     Comment?     @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerReply SellerReply? @relation(fields: [sellerReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetUser  User?        @relation("CaseTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seller      Seller?      @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaAsset  MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  reports            Report[]
  decisions          ModerationDecision[]
  enforcementActions EnforcementAction[]
  appeals            Appeal[]

  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
  @@index([lane, status, holdExpiresAt]) // HOLD lane + expiry sweeper
  @@index([lane, status, postReviewDueAt]) // POST_REVIEW lane + SLA/lapse sweeper
  @@index([lane, status, aiScore])
  @@map("moderation_cases")
}

/// Append-only. Every AI, rule, or human decision on a case, including overrides.
model ModerationDecision {
  id              String             @id @default(cuid())
  caseId          String
  source          DecisionSource
  moderatorId     String? // set when source = HUMAN
  outcome         DecisionOutcome
  policyVersion   String             @db.VarChar(32) // content policy version applied
  aiProvider      String?            @db.VarChar(64)
  aiModel         String?            @db.VarChar(128)
  confidence      Decimal?           @db.Decimal(5, 4) // 0..1
  labels          Json? // category -> score
  reasonCode      String?            @db.VarChar(64)
  rationale       String?            @db.Text // internal
  // M1.2 (moderation-pipeline.md §2, §6.1)
  verdict         ModerationVerdict? // AI/RULE assessments
  configVersion   String?            @db.VarChar(32) // ModerationConfig.version applied
  failureCode     String?            @db.VarChar(32) // AI failure: timeout|http_5xx|http_429|schema|breaker|unsupported_language|lost_job
  publicReason    String?            @db.Text // statement of reasons for REJECT/REMOVE without an EnforcementAction
  bulkOperationId String?            @db.VarChar(32)
  latencyMs       Int?
  createdAt       DateTime           @default(now())

  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  moderator      User?          @relation("DecisionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([moderatorId, createdAt])
  @@index([bulkOperationId])
  @@map("moderation_decisions")
}

/// Sanction against a user OR a seller (exclusive arc). Source of truth for User/Seller status.
model EnforcementAction {
  id                 String            @id @default(cuid())
  type               EnforcementType
  status             EnforcementStatus @default(ACTIVE)
  subjectUserId      String?
  subjectSellerId    String?
  caseId             String?
  reasonCode         String            @db.VarChar(64)
  publicReason       String            @db.Text // statement of reasons, kept exactly as sent (evidence)
  publicReasonLocale String            @default("en") @db.VarChar(16) // ADR-0009: language of publicReason
  internalNote       String?           @db.Text
  issuedById         String? // null = automated (RULE/AI within policy limits)
  startsAt           DateTime          @default(now())
  endsAt             DateTime? // null = permanent
  revokedById        String?
  revokedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  subjectUser    User?           @relation("EnforcementSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectSeller  Seller?         @relation(fields: [subjectSellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  issuedBy       User?           @relation("EnforcementIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy      User?           @relation("EnforcementRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  appeals Appeal[]

  @@index([subjectUserId, status])
  @@index([subjectSellerId, status])
  @@index([status, endsAt]) // expiry job
  @@map("enforcement_actions")
}

/// Appeal against exactly one decision (exclusive arc). Reviewer must differ from the original decider.
model Appeal {
  id                  String       @id @default(cuid())
  appellantId         String
  enforcementActionId String?
  caseId              String?
  purchaseProofId     String?
  ownershipClaimId    String?
  statement           String       @db.Text
  status              AppealStatus @default(SUBMITTED)
  reviewerId          String?
  decisionNote        String?      @db.Text // shown to appellant
  priority            Int          @default(0) // M1.2: HOLD_EXPIRED appeals first
  slaDueAt            DateTime? // M1.2: 7 days, 72 h for HOLD_EXPIRED
  leaseExpiresAt      DateTime? // M1-T2: claim lease for reviewerId (15 min), mirrors ModerationCase.leaseExpiresAt
  submittedAt         DateTime     @default(now())
  decidedAt           DateTime?
  updatedAt           DateTime     @updatedAt

  appellant         User                  @relation("AppealAppellant", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewer          User?                 @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  enforcementAction EnforcementAction?    @relation(fields: [enforcementActionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderationCase    ModerationCase?       @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseProof     PurchaseProof?        @relation(fields: [purchaseProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownershipClaim    SellerOwnershipClaim? @relation(fields: [ownershipClaimId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  attachments MediaAsset[] // purpose APPEAL_EVIDENCE, private

  // one appeal per appellant per decision
  @@unique([appellantId, enforcementActionId])
  @@unique([appellantId, caseId])
  @@unique([appellantId, purchaseProofId])
  @@unique([appellantId, ownershipClaimId])
  @@index([status, submittedAt])
  @@index([status, priority, slaDueAt])
  @@index([reviewerId, status])
  @@map("appeals")
}

// -----------------------------------------------------------------------------
// Trust score inputs & snapshots
// -----------------------------------------------------------------------------

/// Append-only event-like input to trust scoring, for a user OR a seller (exclusive arc).
model TrustSignal {
  id              String          @id @default(cuid())
  subjectUserId   String?
  subjectSellerId String?
  type            TrustSignalType
  value           Decimal         @db.Decimal(10, 4) // signed contribution before weighting
  sourceRef       String?         @db.VarChar(191) // e.g. "review:<id>", "case:<id>"
  occurredAt      DateTime        @default(now())
  expiresAt       DateTime? // decay horizon
  createdAt       DateTime        @default(now())

  subjectUser   User?   @relation("TrustSignalUser", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectSeller Seller? @relation("TrustSignalSeller", fields: [subjectSellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subjectUserId, type, occurredAt])
  @@index([subjectSellerId, type, occurredAt])
  @@map("trust_signals")
}

/// Append-only computed score with explainable components. Latest row is cached on User/Seller.
model TrustScoreSnapshot {
  id               String    @id @default(cuid())
  subjectUserId    String?
  subjectSellerId  String?
  score            Decimal   @db.Decimal(5, 2) // 0..100
  band             TrustBand
  algorithmVersion String    @db.VarChar(32)
  components       Json // { inputName: { raw, weight, contribution } }
  computedAt       DateTime  @default(now())

  subjectUser   User?   @relation("TrustScoreUser", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectSeller Seller? @relation("TrustScoreSeller", fields: [subjectSellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subjectUserId, computedAt])
  @@index([subjectSellerId, computedAt])
  @@map("trust_score_snapshots")
}

// -----------------------------------------------------------------------------
// Notifications
// -----------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  entityType  String?          @db.VarChar(50) // loose ref: notifications must survive target deletion
  entityId    String?          @db.VarChar(191)
  data        Json? // render params; no secrets, minimal PII
  groupKey    String?          @db.VarChar(191) // aggregation ("12 people liked your post")
  readAt      DateTime?
  emailedAt   DateTime?
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, groupKey])
  @@map("notifications")
}

model NotificationPreference {
  userId  String
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

// -----------------------------------------------------------------------------
// Audit & infrastructure
// -----------------------------------------------------------------------------

/// Append-only. No FKs on purpose: entries must outlive the entities they describe.
/// The app DB user gets INSERT/SELECT only on this table (no UPDATE/DELETE).
model AuditLog {
  id         BigInt         @id @default(autoincrement())
  occurredAt DateTime       @default(now())
  actorType  AuditActorType
  actorId    String?        @db.VarChar(191)
  actorRoles String?        @db.VarChar(255) // snapshot, e.g. "MODERATOR,ADMIN"
  action     String         @db.VarChar(100) // e.g. "review.remove", "role.grant", "proof.view_original"
  entityType String         @db.VarChar(50)
  entityId   String?        @db.VarChar(191)
  sellerId   String?        @db.VarChar(191) // scope context for seller-scoped actions
  reason     String?        @db.Text
  metadata   Json? // before/after diff with PII redacted
  requestId  String?        @db.VarChar(64)
  ipHash     String?        @db.Char(64) // OPEN(LEGAL)
  userAgent  String?        @db.VarChar(512)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same DB transaction as the domain change,
/// relayed to the job queue by the worker (ADR-0001, ADR-0007). Column names match
/// the scaffold (packages/db); aggregateType/attempts/lastError are added in M2.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  type          String    @db.VarChar(100) // event type, e.g. "review.submitted", "media.uploaded"
  aggregateType String    @db.VarChar(50) // e.g. "Review", "MediaAsset"
  aggregateId   String    @db.VarChar(64)
  payload       Json // ids + versions only; never PII or content (ADR-0007 §4)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime? // set after BullMQ accepted the job
  attempts      Int       @default(0) // relay publish attempts; rows at the cap are skipped and alerted
  lastError     String?   @db.VarChar(1000) // truncated and scrubbed

  @@index([publishedAt, id])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// M1.2: moderation configuration and media processing logs
// -----------------------------------------------------------------------------

/// Versioned, immutable moderation thresholds/timers (moderation-pipeline.md §5,
/// example payload: moderation-config.example.json). Exactly one ACTIVE row and at
/// most one SHADOW row (application rule). Activation needs config.manage + step-up
/// and is audited. Staff ids are plain strings (no FK) so config history outlives
/// staff account erasure, like AuditLog.
model ModerationConfig {
  id            String                 @id @default(cuid())
  version       String                 @unique @db.VarChar(32)
  status        ModerationConfigStatus @default(DRAFT)
  config        Json // validated by the zod schema in packages/core before save
  checksum      String                 @db.Char(64) // sha256 of canonical JSON
  note          String?                @db.Text
  createdById   String                 @db.VarChar(191)
  activatedById String?                @db.VarChar(191)
  activatedAt   DateTime?
  retiredAt     DateTime?
  createdAt     DateTime               @default(now())

  @@index([status])
  @@map("moderation_configs")
}

/// Append-only scan/upload log, one row per pipeline step (media-pipeline.md §7).
/// No FK so rows outlive purged assets. Never contains file names or metadata values.
model MediaProcessingLog {
  id               BigInt                 @id @default(autoincrement())
  mediaAssetId     String                 @db.VarChar(191)
  step             MediaProcessingStep
  outcome          MediaProcessingOutcome
  attempt          Int                    @default(1)
  engine           String?                @db.VarChar(64) // clamav | sharp | ffmpeg | <ai provider>
  engineVersion    String?                @db.VarChar(64)
  signatureVersion String?                @db.VarChar(64) // ClamAV signature DB version
  detail           Json? // e.g. threat name, ffprobe summary, tag groups removed
  durationMs       Int?
  actorId          String?                @db.VarChar(191) // uploader for SLOT_ISSUED / UPLOAD_CONFIRMED
  ipHash           String?                @db.Char(64) // OPEN(LEGAL): nulled after 90 days
  jobId            String?                @db.VarChar(128)
  createdAt        DateTime               @default(now())

  @@index([mediaAssetId, createdAt])
  @@index([step, outcome, createdAt])
  @@map("media_processing_logs")
}
