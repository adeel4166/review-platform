  contestResponseDueAt DateTime?            @db.DateTime(3)
  infoRequestedAt      DateTime?            @db.DateTime(3)
  checkAttempts        Int                  @default(0)
  lastCheckAt          DateTime?            @db.DateTime(3)
  lastCheckOutcome     ClaimCheckOutcome?
  nextCheckAt          DateTime?            @db.DateTime(3)
