// Adopted from docs/architecture/schema.draft.prisma (latest merged data model: task #24 / M1-T1,
// which supersedes #18). Adopted so far (M2-1): identity (User, UserRole), catalogue (Category,
// Product) and Review/ReviewRevision. Remaining draft tables are adopted by later feature tasks.
// Relations to not-yet-adopted tables (Seller, MediaAsset, PurchaseProof, ...) are omitted for now.
// Physical names follow ADR-0010; CHECK constraints live in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  DELETED
}

/// Global staff roles. "USER" is implicit (any active account) and not stored.
enum PlatformRole {
  MODERATOR
  SENIOR_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  PENDING
  ACTIVE
  MERGED
  ARCHIVED
  REMOVED
}

enum ContentStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  REMOVED
  DELETED
}

enum IncentiveDisclosure {
  NONE
  FREE_PRODUCT
  DISCOUNT
  PAYMENT
  OTHER
}

enum RevisionStatus {
  PENDING
  HELD
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ModerationSubjectType {
  REVIEW
  SELLER_REPLY
  MEDIA
}

enum ModerationState {
  PENDING
  AI_REVIEW
  NEEDS_HUMAN
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ModerationTrigger {
  SUBMISSION
  EDIT
  USER_REPORT
  STAFF_FLAG
  STAFF_INITIATED
  VOTE_ANOMALY
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum AuditActorType {
  USER
  STAFF
  AI
  SYSTEM
}

model User {
  assignedCases         ModerationCase[]       @relation("CaseAssignee")
  decisionsMade         ModerationDecision[]   @relation("DecisionModerator")
  appealsFiled          Appeal[]               @relation("AppealAppellant")
  hiddenReviewSummaries ProductReviewSummary[] @relation("ReviewSummaryHiddenBy")
  appealsReviewed       Appeal[]               @relation("AppealReviewer")
  approvalsRequested    StaffApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided      StaffApprovalRequest[] @relation("ApprovalDecider")
  breakGlassAccesses    BreakGlassAccess[]     @relation("BreakGlassStaff")
  id                    String                 @id @default(cuid())
  sellerReplies         SellerReply[]          @relation("ReplyAuthor")
  repliesDeleted        SellerReply[]          @relation("ReplyDeletedBy")
  email                 String                 @unique
  emailVerifiedAt       DateTime?
  passwordHash          String?                @db.VarChar(255)
  handle                String                 @unique @db.VarChar(32)
  displayName           String                 @db.VarChar(64)
  bio                   String?                @db.Text
  locale                String?                @db.VarChar(16)
  timeZone              String?                @db.VarChar(64)
  status                UserStatus             @default(ACTIVE)
  lastLoginAt           DateTime?
  /// Throttle for the "someone tried to register" mail (ADR-0016): at most one per hour.
  accountExistsNoticeAt DateTime?
  trustScore            Decimal?               @db.Decimal(5, 2)
  trustBand             TrustBand              @default(NEW)
  trustComputedAt       DateTime?              @db.DateTime(3)
  handleChangedAt       DateTime?              @db.DateTime(3)
  followsMade           Follow[]               @relation("Follower")
  followsReceived       Follow[]               @relation("FollowedUser")
  blocksMade            UserBlock[]            @relation("Blocker")
  blocksReceived        UserBlock[]            @relation("Blocked")
  notifications         Notification[]         @relation("NotificationRecipient")
  notificationPrefs     NotificationPreference[]
  erasureRequest        ErasureRequest?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  roles           UserRole[]               @relation("UserRoles")
  rolesGranted    UserRole[]               @relation("RoleGrantedBy")
  productsCreated Product[]                @relation("ProductCreatedBy")
  reviews         Review[]                 @relation("ReviewAuthor")
  revisionsEdited ReviewRevision[]         @relation("RevisionEditor")
  mediaAssets     MediaAsset[]             @relation("MediaOwner")
  casesDecided    ModerationCase[]         @relation("CaseDecidedBy")
  auditLogs       AuditLog[]               @relation("AuditActor")
  emailTokens     EmailVerificationToken[]
  sessions        UserSession[]
  twoFactorTotp   TwoFactorTotp?
  recoveryCodes   RecoveryCode[]

  sellerMemberships    SellerMember[]              @relation("SellerMembership")
  sellersCreated       Seller[]                    @relation("SellerCreatedBy")
  invitationsSent      SellerInvitation[]          @relation("InvitationSentBy")
  invitationsAccepted  SellerInvitation[]          @relation("InvitationAcceptedBy")
  invitationsRevoked   SellerInvitation[]          @relation("InvitationRevokedBy")
  transfersInitiated   SellerOwnershipTransfer[]   @relation("TransferInitiator")
  transfersTargeted    SellerOwnershipTransfer[]   @relation("TransferTarget")
  transfersEnded       SellerOwnershipTransfer[]   @relation("TransferEndedBy")
  transferCancelTokens SellerTransferCancelToken[] @relation("TransferCancelRecipient")
  ownershipClaims      SellerOwnershipClaim[]      @relation("ClaimSubmittedBy")
  claimDecisions       SellerClaimDecision[]       @relation("ClaimDecisionReviewer")
  enforcementsReceived EnforcementAction[]         @relation("EnforcementSubjectUser")
  enforcementsIssued   EnforcementAction[]         @relation("EnforcementIssuedBy")
  enforcementsRevoked  EnforcementAction[]         @relation("EnforcementRevokedBy")
  votes                ReviewVote[]                @relation("ReviewVoter")
  reports              Report[]                    @relation("ReportReporter")
  resolvedReports      Report[]                    @relation("ReportResolvedBy")
  proofsSubmitted      PurchaseProof[]             @relation("ProofSubmittedBy")
  proofsReviewed       PurchaseProof[]             @relation("ProofReviewedBy")
  proofFiles           PurchaseProofFile[]         @relation("ProofFileOwner")
  productImagesCreated ProductImage[]              @relation("ProductImageCreatedBy")

  @@index([status])
  @@map("users")
}

model UserRole {
  userId      String
  role        PlatformRole
  grantedById String?
  grantedAt   DateTime     @default(now())
  reason      String?      @db.VarChar(255)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(160)
  name          String        @db.VarChar(200)
  brandName     String?       @db.VarChar(120)
  description   String?       @db.Text
  categoryId    String
  gtin          String?       @unique @db.VarChar(14)
  mpn           String?       @db.VarChar(64)
  specs         Json?
  status        ProductStatus @default(PENDING)
  mergedIntoId  String?
  createdById   String
  /// Owning seller, set by a VERIFIED PRODUCT claim (M3-06); null = unclaimed. Never taken from client input (P-2).
  sellerId      String?
  ratingAverage Decimal?      @db.Decimal(3, 2) // cache, maintained by the worker
  ratingCount   Int           @default(0)
  reviewCount   Int           @default(0)
  verifiedRatingAverage Decimal? @db.Decimal(3, 2)
  verifiedRatingCount   Int      @default(0)
  ratingHistogram       Json?
  aggregateComputedAt   DateTime? @db.DateTime(3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mergedInto Product?  @relation("ProductMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Product[] @relation("ProductMerge")
  createdBy  User      @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  seller     Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  reviews         Review[]
  ownershipClaims SellerOwnershipClaim[]
  images          ProductImage[]
  reviewSummaries ProductReviewSummary[]

  @@index([sellerId])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("products")
}

/// One review per (product, author), ever. Edits create ReviewRevision rows.
model Review {
  id                 String               @id @default(cuid())
  productId          String
  authorId           String
  rating             Int                  @db.TinyInt // 1..5, CHECK in migration
  title              String               @db.VarChar(150)
  body               String               @db.Text
  incentive          IncentiveDisclosure  @default(NONE)
  language           String?              @db.VarChar(16)
  status             ContentStatus        @default(PENDING)
  currentVersion     Int                  @default(1)
  publishedVersion   Int?
  helpfulCount       Int                  @default(0)
  helpfulWeighted    Decimal              @default(0) @db.Decimal(10, 2)
  votesFrozenAt      DateTime?            @db.DateTime(3)
  /// Set while the review belongs to an open ProductBurst window; excluded from aggregates until a human decision (TRS-004).
  aggregateExcludedAt DateTime?           @db.DateTime(3)
  notHelpfulCount    Int                  @default(0)
  commentCount       Int                  @default(0)
  verifiedBuyer      Boolean              @default(false)
  verifiedAt         DateTime?
  verifiedOrderId    String?              @db.VarChar(64)
  /// ADR-0008: set only by a staff proof decision (all three together, chk_review_verified_label). `verifiedBuyer` is the legacy mirror kept for the read paths.
  verifiedPurchaseAt DateTime?            @db.DateTime(3)
  verificationMethod PurchaseProofMethod?
  verifiedProofId    String?              @unique
  publishedAt        DateTime?
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  revisions     ReviewRevision[]
  cases         ModerationCase[]
  media         MediaAsset[]
  sellerReplies SellerReply[]
  votes         ReviewVote[]
  reports       Report[]
  proofs        PurchaseProof[]     @relation("ReviewProofs")
  verifiedProof PurchaseProof?      @relation("ReviewVerifiedProof", fields: [verifiedProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revocations   EnforcementAction[] @relation("EnforcementSubjectReview")

  @@unique([productId, authorId])
  @@index([productId, status, verifiedPurchaseAt])
  @@index([productId, status, publishedAt])
  @@index([productId, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewRevision {
  id        String              @id @default(cuid())
  reviewId  String
  version   Int
  incentive IncentiveDisclosure @default(NONE)
  rating    Int                 @db.TinyInt
  title     String              @db.VarChar(150)
  body      String              @db.Text
  editorId  String
  status    RevisionStatus      @default(PENDING)
  createdAt DateTime            @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  editor User   @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([reviewId, version])
  @@map("review_revisions")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(100)
  aggregateId String    @db.VarChar(64)
  payload     Json
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

/// One case per (review, version). `state` is the moderation workflow; Review.status mirrors it (ADR-0005).
model ModerationCase {
  id                   String                @id @default(cuid())
  subjectType          ModerationSubjectType @default(REVIEW)
  reviewId             String?
  sellerReplyId        String?
  version              Int
  state                ModerationState       @default(PENDING)
  aiScore              Decimal?              @db.Decimal(4, 3)
  aiConfidence         Decimal?              @db.Decimal(4, 3)
  aiReasons            Json?
  aiProvider           String?               @db.VarChar(64)
  decisionReason       String?               @db.VarChar(500)
  decidedById          String?
  decidedAt            DateTime?
  trigger              ModerationTrigger     @default(SUBMISSION)
  seq                  Int                   @default(1)
  /// `R:<reviewId>` / `S:<sellerReplyId>` while a report case is open (NEEDS_HUMAN), NULL once resolved (m4-m5-spec 4.3).
  openReportKey        String?               @unique @db.VarChar(40)
  reportCount          Int                   @default(0)
  reportWeight         Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // ---- M6 (ADR-0025): status + lane model. Legacy `state` & friends stay until call sites are re-pointed (step 2 of the migration). ----
  mediaAssetId         String?
  status               CaseStatus            @default(OPEN)
  lane                 ModerationLane?
  priority             Int                   @default(0)
  assignedToId         String?
  leaseExpiresAt       DateTime?             @db.DateTime(3)
  slaDueAt             DateTime?             @db.DateTime(3)
  outcome              DecisionOutcome?
  resolutionCode       String?               @db.VarChar(64)
  resolvedAt           DateTime?             @db.DateTime(3)
  contentSnapshot      Json?
  aiVerdict            ModerationVerdict?
  aiTopCategory        String?               @db.VarChar(64)
  aiReason             String?               @db.VarChar(500)
  configVersion        String?               @db.VarChar(32)
  holdExpiresAt        DateTime?             @db.DateTime(3)
  postReviewDueAt      DateTime?             @db.DateTime(3)
  postReviewBreachedAt DateTime?             @db.DateTime(3)
  appealableUntil      DateTime?             @db.DateTime(3)
  legalHold            Boolean               @default(false)
  rescanCount          Int                   @default(0)
  /// "<lane>:<R|S|M>:<id>" while not RESOLVED, NULL after (one open case per target and lane).
  openKey              String?               @unique @db.VarChar(48)

  reports            Report[]
  review             Review?              @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerReply        SellerReply?         @relation(fields: [sellerReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy          User?                @relation("CaseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  enforcementActions EnforcementAction[]
  mediaAsset         MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedTo         User?                @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  decisions          ModerationDecision[]
  appeals            Appeal[]

  @@unique([mediaAssetId, version, trigger, seq])
  @@unique([reviewId, version, trigger, seq])
  @@unique([sellerReplyId, version, trigger, seq])
  @@index([lane, status, holdExpiresAt])
  @@index([lane, status, postReviewDueAt])
  @@index([lane, status, priority, createdAt])
  @@index([assignedToId, status])
  @@index([status, appealableUntil])
  @@index([state, createdAt])
  @@index([trigger, state, reportWeight])
  @@map("moderation_cases")
}

/// Append-only audit trail (never updated or deleted by the app).
model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorType  AuditActorType
  actorId    String?
  action     String         @db.VarChar(64)
  entityType String         @db.VarChar(32)
  entityId   String         @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime       @default(now()) @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, id])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Review image (MVP: jpeg/png/webp). Bytes land in the ingest bucket via a presigned PUT; the worker validates by
/// content, strips metadata, writes thumb/medium variants to the private bucket and sets READY or FAILED.
/// Public visibility = status READY AND the parent review PUBLISHED (enforced in the read queries).
model MediaAsset {
  appealId            String?
  appeal              Appeal?          @relation("AppealEvidence", fields: [appealId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  moderationCases     ModerationCase[]
  id                  String           @id @default(cuid())
  ownerId             String
  /// NULL only for purpose = PRODUCT_IMAGE (chk_media_purpose_owner, ADR-0034 D11).
  reviewId            String?
  purpose             MediaPurpose     @default(REVIEW)
  status              MediaStatus      @default(UPLOADING)
  declaredMime        String           @db.VarChar(64)
  sizeBytes           Int
  detectedMime        String?          @db.VarChar(64)
  width               Int?
  height              Int?
  ingestKey           String           @db.VarChar(255)
  thumbKey            String?          @db.VarChar(255)
  mediumKey           String?          @db.VarChar(255)
  failureReason       String?          @db.VarChar(64)
  processedAt         DateTime?
  /// First review version whose moderation covered this asset; NULL = staged for the next edit (m4-m5-spec 3.4).
  attachedInVersion   Int?
  /// First version that no longer shows it.
  detachedInVersion   Int?
  /// M5 pipeline (m4-m5-spec 7-10). `bucket` says where the bytes live; PUBLIC only after scan + sanitise + moderation (MED-037).
  kind                MediaKind        @default(IMAGE)
  bucket              MediaBucket      @default(INGEST)
  sha256              String?          @db.VarChar(64)
  virusScannedAt      DateTime?
  metadataStripped    Boolean          @default(false)
  moderationClearedAt DateTime?
  promotedAt          DateTime?
  /// Video only: transcoded MP4 and its poster frame (same bucket as thumbKey/mediumKey).
  videoKey            String?          @db.VarChar(255)
  posterKey           String?          @db.VarChar(255)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  logs   MediaProcessingLog[]
  owner  User                 @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  review Review?              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  productImage ProductImage?

  @@index([reviewId, status])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

enum MediaPurpose {
  REVIEW
  PRODUCT_IMAGE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaBucket {
  INGEST
  PRIVATE
  PUBLIC
}

/// One row per pipeline step. Scan rows carry the ClamAV engine and signature version (INF-003, MED-041). Never holds file names or threat names shown to users.
model MediaProcessingLog {
  id               String   @id @default(cuid())
  assetId          String
  step             String   @db.VarChar(32)
  outcome          String   @db.VarChar(32)
  engineVersion    String?  @db.VarChar(64)
  signatureVersion String?  @db.VarChar(32)
  detail           Json?
  createdAt        DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("media_processing_logs")
}

/// sha256 of files that must never be accepted again (MED-016).
model BannedMediaHash {
  sha256    String   @id @db.VarChar(64)
  reason    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("banned_media_hashes")
}

enum EmailTokenPurpose {
  ACCOUNT_EMAIL // prove control of User.email
  CLAIM_BUSINESS_EMAIL // reserved for M3-06 claim checks
}

/// ADR-0016. The web app inserts the row with tokenHash NULL; the worker generates the raw token, stores only
/// its SHA-256 hex digest, then mails it. Single use, 24 h expiry, bound to the target address.
model EmailVerificationToken {
  id            String            @id @default(cuid())
  userId        String
  purpose       EmailTokenPurpose
  email         String            @db.VarChar(254)
  claimId       String? // CLAIM_BUSINESS_EMAIL only: the claim this token verifies (m3b-spec 4.4)
  tokenHash     String?           @unique @db.Char(64)
  expiresAt     DateTime          @db.DateTime(3)
  sentAt        DateTime?         @db.DateTime(3)
  consumedAt    DateTime?         @db.DateTime(3)
  invalidatedAt DateTime?         @db.DateTime(3)
  createdAt     DateTime          @default(now()) @db.DateTime(3)

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim SellerOwnershipClaim? @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, purpose, createdAt])
  @@index([claimId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------------------------------------------
// M3-04: sellers, memberships, invitations, enforcement, ownership claims (docs/architecture/m3-sellers-spec.md §2).
// FKs on CHECK-carrying columns are Restrict/Restrict (MySQL ER 3823).
// ---------------------------------------------------------------------------------------------------------------

enum SellerStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  CLOSED
}

enum SellerMemberRole {
  OWNER
  MANAGER
  RESPONDER
}

enum OwnershipClaimScope {
  SELLER
  PRODUCT
}

enum OwnershipProofMethod {
  DNS_TXT
  META_TAG
  BUSINESS_EMAIL_DOMAIN
  DOCUMENT
  MARKETPLACE
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  CONTESTED
  EXPIRED
  REVOKED
  WITHDRAWN
}

enum ClaimEndReason {
  CHALLENGE_TIMEOUT
  INFO_TIMEOUT
  VALIDITY_ENDED
  REVERIFY_FAILED
  CONTEST_LOST
  SPOT_CHECK_FAILED
  STAFF_REVOKED
}

enum ClaimCheckOutcome {
  PASS
  NOT_FOUND
  MISMATCH
  FETCH_BLOCKED
  FETCH_ERROR
  DNS_ERROR
}

enum ClaimDecisionSource {
  RULE
  STAFF
}

enum ClaimDecisionOutcome {
  APPROVE
  REJECT
  REQUEST_INFO
  RENEW
  SPOT_CHECK_PASS
  SPOT_CHECK_FAIL
  REVOKE
}

enum EnforcementType {
  WARNING
  CONTENT_REMOVAL
  POSTING_RESTRICTION
  VOTING_RESTRICTION
  VERIFIED_LABEL_REVOKED
  SUSPENSION
  BAN
  SELLER_REPLY_RESTRICTION
  SELLER_SUSPENSION
}

enum EnforcementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  OVERTURNED
}

model Seller {
  id              String       @id @default(cuid())
  slug            String       @unique @db.VarChar(80)
  name            String       @db.VarChar(120)
  nameSkeleton    String       @db.VarChar(120)
  description     String?      @db.Text
  websiteUrl      String?      @db.VarChar(2048)
  countryCode     String?      @db.Char(2)
  status          SellerStatus @default(UNVERIFIED)
  verifiedClaimId String?
  verifiedDomain  String?      @db.VarChar(253)
  verifiedAt      DateTime?    @db.DateTime(3)
  nameReviewFlag  Boolean      @default(false)
  trustScore      Decimal?     @db.Decimal(5, 2)
  trustBand       TrustBand    @default(LOW)
  trustComputedAt DateTime?    @db.DateTime(3)
  closedAt        DateTime?    @db.DateTime(3)
  createdById     String
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  createdBy     User                  @relation("SellerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// The verified claim must belong to this seller (composite FK, SEL-011).
  verifiedClaim SellerOwnershipClaim? @relation("SellerVerifiedClaim", fields: [verifiedClaimId, id], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)

  members            SellerMember[]
  invitations        SellerInvitation[]
  ownershipTransfers SellerOwnershipTransfer[]
  replies            SellerReply[]
  ownershipClaims    SellerOwnershipClaim[]    @relation("ClaimSeller")
  products           Product[]
  enforcementActions EnforcementAction[]

  @@unique([verifiedClaimId, id])
  @@index([status])
  @@index([nameSkeleton])
  @@map("sellers")
}

/// Accepted membership only. Pending invitations live in SellerInvitation. At least one OWNER per seller (service).
model SellerMember {
  sellerId     String
  userId       String
  role         SellerMemberRole
  invitationId String?          @unique
  createdAt    DateTime         @default(now()) @db.DateTime(3)
  updatedAt    DateTime         @updatedAt @db.DateTime(3)

  seller     Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user       User              @relation("SellerMembership", fields: [userId], references: [id], onDelete: Cascade)
  invitation SellerInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@id([sellerId, userId])
  @@index([userId])
  @@index([sellerId, role])
  @@map("seller_members")
}

/// SEL-007: 7-day, single-use, bound to the invitee's verified email. M3a roles: MANAGER, RESPONDER only.
model SellerInvitation {
  id           String           @id @default(cuid())
  sellerId     String
  email        String           @db.VarChar(254)
  role         SellerMemberRole
  tokenHash    String?          @unique @db.Char(64)
