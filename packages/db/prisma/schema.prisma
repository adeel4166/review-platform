// Adopted from docs/architecture/schema.draft.prisma (latest merged data model: task #24 / M1-T1,
// which supersedes #18). Adopted so far (M2-1): identity (User, UserRole), catalogue (Category,
// Product) and Review/ReviewRevision. Remaining draft tables are adopted by later feature tasks.
// Relations to not-yet-adopted tables (Seller, MediaAsset, PurchaseProof, ...) are omitted for now.
// Physical names follow ADR-0010; CHECK constraints live in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  DELETED
}

/// Global staff roles. "USER" is implicit (any active account) and not stored.
enum PlatformRole {
  MODERATOR
  SENIOR_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  PENDING
  ACTIVE
  MERGED
  ARCHIVED
  REMOVED
}

enum ContentStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  REMOVED
  DELETED
}

enum IncentiveDisclosure {
  NONE
  FREE_PRODUCT
  DISCOUNT
  PAYMENT
  OTHER
}

enum RevisionStatus {
  PENDING
  HELD
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ModerationSubjectType {
  REVIEW
  SELLER_REPLY
}

enum ModerationState {
  PENDING
  AI_REVIEW
  NEEDS_HUMAN
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ModerationTrigger {
  SUBMISSION
  EDIT
  USER_REPORT
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum AuditActorType {
  USER
  STAFF
  AI
  SYSTEM
}

model User {
  id                    String        @id @default(cuid())
  sellerReplies         SellerReply[] @relation("ReplyAuthor")
  repliesDeleted        SellerReply[] @relation("ReplyDeletedBy")
  email                 String        @unique
  emailVerifiedAt       DateTime?
  passwordHash          String?       @db.VarChar(255)
  handle                String        @unique @db.VarChar(32)
  displayName           String        @db.VarChar(64)
  bio                   String?       @db.Text
  locale                String?       @db.VarChar(16)
  timeZone              String?       @db.VarChar(64)
  status                UserStatus    @default(ACTIVE)
  lastLoginAt           DateTime?
  /// Throttle for the "someone tried to register" mail (ADR-0016): at most one per hour.
  accountExistsNoticeAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  roles           UserRole[]               @relation("UserRoles")
  rolesGranted    UserRole[]               @relation("RoleGrantedBy")
  productsCreated Product[]                @relation("ProductCreatedBy")
  reviews         Review[]                 @relation("ReviewAuthor")
  revisionsEdited ReviewRevision[]         @relation("RevisionEditor")
  mediaAssets     MediaAsset[]             @relation("MediaOwner")
  casesDecided    ModerationCase[]         @relation("CaseDecidedBy")
  auditLogs       AuditLog[]               @relation("AuditActor")
  emailTokens     EmailVerificationToken[]
  sessions        UserSession[]
  twoFactorTotp   TwoFactorTotp?
  recoveryCodes   RecoveryCode[]

  sellerMemberships    SellerMember[]              @relation("SellerMembership")
  sellersCreated       Seller[]                    @relation("SellerCreatedBy")
  invitationsSent      SellerInvitation[]          @relation("InvitationSentBy")
  invitationsAccepted  SellerInvitation[]          @relation("InvitationAcceptedBy")
  invitationsRevoked   SellerInvitation[]          @relation("InvitationRevokedBy")
  transfersInitiated   SellerOwnershipTransfer[]   @relation("TransferInitiator")
  transfersTargeted    SellerOwnershipTransfer[]   @relation("TransferTarget")
  transfersEnded       SellerOwnershipTransfer[]   @relation("TransferEndedBy")
  transferCancelTokens SellerTransferCancelToken[] @relation("TransferCancelRecipient")
  ownershipClaims      SellerOwnershipClaim[]      @relation("ClaimSubmittedBy")
  claimDecisions       SellerClaimDecision[]       @relation("ClaimDecisionReviewer")
  enforcementsReceived EnforcementAction[]         @relation("EnforcementSubjectUser")
  enforcementsIssued   EnforcementAction[]         @relation("EnforcementIssuedBy")
  enforcementsRevoked  EnforcementAction[]         @relation("EnforcementRevokedBy")
  votes                ReviewVote[]                @relation("ReviewVoter")
  reports              Report[]                    @relation("ReportReporter")
  resolvedReports      Report[]                    @relation("ReportResolvedBy")
  proofsSubmitted      PurchaseProof[]             @relation("ProofSubmittedBy")
  proofsReviewed       PurchaseProof[]             @relation("ProofReviewedBy")
  proofFiles           PurchaseProofFile[]         @relation("ProofFileOwner")

  @@index([status])
  @@map("users")
}

model UserRole {
  userId      String
  role        PlatformRole
  grantedById String?
  grantedAt   DateTime     @default(now())
  reason      String?      @db.VarChar(255)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(160)
  name          String        @db.VarChar(200)
  brandName     String?       @db.VarChar(120)
  description   String?       @db.Text
  categoryId    String
  gtin          String?       @unique @db.VarChar(14)
  mpn           String?       @db.VarChar(64)
  specs         Json?
  status        ProductStatus @default(PENDING)
  mergedIntoId  String?
  createdById   String
  /// Owning seller, set by a VERIFIED PRODUCT claim (M3-06); null = unclaimed. Never taken from client input (P-2).
  sellerId      String?
  ratingAverage Decimal?      @db.Decimal(3, 2) // cache, maintained by the worker
  ratingCount   Int           @default(0)
  reviewCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mergedInto Product?  @relation("ProductMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Product[] @relation("ProductMerge")
  createdBy  User      @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  seller     Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  reviews         Review[]
  ownershipClaims SellerOwnershipClaim[]

  @@index([sellerId])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("products")
}

/// One review per (product, author), ever. Edits create ReviewRevision rows.
model Review {
  id                 String               @id @default(cuid())
  productId          String
  authorId           String
  rating             Int                  @db.TinyInt // 1..5, CHECK in migration
  title              String               @db.VarChar(150)
  body               String               @db.Text
  incentive          IncentiveDisclosure  @default(NONE)
  language           String?              @db.VarChar(16)
  status             ContentStatus        @default(PENDING)
  currentVersion     Int                  @default(1)
  publishedVersion   Int?
  helpfulCount       Int                  @default(0)
  notHelpfulCount    Int                  @default(0)
  commentCount       Int                  @default(0)
  verifiedBuyer      Boolean              @default(false)
  verifiedAt         DateTime?
  verifiedOrderId    String?              @db.VarChar(64)
  /// ADR-0008: set only by a staff proof decision (all three together, chk_review_verified_label). `verifiedBuyer` is the legacy mirror kept for the read paths.
  verifiedPurchaseAt DateTime?            @db.DateTime(3)
  verificationMethod PurchaseProofMethod?
  verifiedProofId    String?              @unique
  publishedAt        DateTime?
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  revisions     ReviewRevision[]
  cases         ModerationCase[]
  media         MediaAsset[]
  sellerReplies SellerReply[]
  votes         ReviewVote[]
  reports       Report[]
  proofs        PurchaseProof[]     @relation("ReviewProofs")
  verifiedProof PurchaseProof?      @relation("ReviewVerifiedProof", fields: [verifiedProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revocations   EnforcementAction[] @relation("EnforcementSubjectReview")

  @@unique([productId, authorId])
  @@index([productId, status, verifiedPurchaseAt])
  @@index([productId, status, publishedAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewRevision {
  id        String              @id @default(cuid())
  reviewId  String
  version   Int
  incentive IncentiveDisclosure @default(NONE)
  rating    Int                 @db.TinyInt
  title     String              @db.VarChar(150)
  body      String              @db.Text
  editorId  String
  status    RevisionStatus      @default(PENDING)
  createdAt DateTime            @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  editor User   @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([reviewId, version])
  @@map("review_revisions")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(100)
  aggregateId String    @db.VarChar(64)
  payload     Json
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

/// One case per (review, version). `state` is the moderation workflow; Review.status mirrors it (ADR-0005).
model ModerationCase {
  id             String                @id @default(cuid())
  subjectType    ModerationSubjectType @default(REVIEW)
  reviewId       String?
  sellerReplyId  String?
  version        Int
  state          ModerationState       @default(PENDING)
  aiScore        Decimal?              @db.Decimal(4, 3)
  aiConfidence   Decimal?              @db.Decimal(4, 3)
  aiReasons      Json?
  aiProvider     String?               @db.VarChar(64)
  decisionReason String?               @db.VarChar(500)
  decidedById    String?
  decidedAt      DateTime?
  trigger        ModerationTrigger     @default(SUBMISSION)
  seq            Int                   @default(1)
  /// `R:<reviewId>` / `S:<sellerReplyId>` while a report case is open (NEEDS_HUMAN), NULL once resolved (m4-m5-spec 4.3).
  openReportKey  String?               @unique @db.VarChar(40)
  reportCount    Int                   @default(0)
  reportWeight   Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  reports            Report[]
  review             Review?             @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerReply        SellerReply?        @relation(fields: [sellerReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy          User?               @relation("CaseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  enforcementActions EnforcementAction[]

  @@unique([reviewId, version, trigger, seq])
  @@unique([sellerReplyId, version, trigger, seq])
  @@index([state, createdAt])
  @@index([trigger, state, reportWeight])
  @@map("moderation_cases")
}

/// Append-only audit trail (never updated or deleted by the app).
model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorType  AuditActorType
  actorId    String?
  action     String         @db.VarChar(64)
  entityType String         @db.VarChar(32)
  entityId   String         @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime       @default(now()) @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, id])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Review image (MVP: jpeg/png/webp). Bytes land in the ingest bucket via a presigned PUT; the worker validates by
/// content, strips metadata, writes thumb/medium variants to the private bucket and sets READY or FAILED.
/// Public visibility = status READY AND the parent review PUBLISHED (enforced in the read queries).
model MediaAsset {
  id                String      @id @default(cuid())
  ownerId           String
  reviewId          String
  status            MediaStatus @default(UPLOADING)
  declaredMime      String      @db.VarChar(64)
  sizeBytes         Int
  detectedMime      String?     @db.VarChar(64)
  width             Int?
  height            Int?
  ingestKey         String      @db.VarChar(255)
  thumbKey          String?     @db.VarChar(255)
  mediumKey         String?     @db.VarChar(255)
  failureReason     String?     @db.VarChar(64)
  processedAt       DateTime?
  /// First review version whose moderation covered this asset; NULL = staged for the next edit (m4-m5-spec 3.4).
  attachedInVersion Int?
  /// First version that no longer shows it.
  detachedInVersion Int?
  /// M5 pipeline (m4-m5-spec 7-10). `bucket` says where the bytes live; PUBLIC only after scan + sanitise + moderation (MED-037).
  kind              MediaKind   @default(IMAGE)
  bucket            MediaBucket @default(INGEST)
  sha256            String?     @db.VarChar(64)
  virusScannedAt    DateTime?
  metadataStripped  Boolean     @default(false)
  moderationClearedAt DateTime?
  promotedAt        DateTime?
  /// Video only: transcoded MP4 and its poster frame (same bucket as thumbKey/mediumKey).
  videoKey          String?     @db.VarChar(255)
  posterKey         String?     @db.VarChar(255)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  logs MediaProcessingLog[]
  owner  User   @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaBucket {
  INGEST
  PRIVATE
  PUBLIC
}

/// One row per pipeline step. Scan rows carry the ClamAV engine and signature version (INF-003, MED-041). Never holds file names or threat names shown to users.
model MediaProcessingLog {
  id               String   @id @default(cuid())
  assetId          String
  step             String   @db.VarChar(32)
  outcome          String   @db.VarChar(32)
  engineVersion    String?  @db.VarChar(64)
  signatureVersion String?  @db.VarChar(32)
  detail           Json?
  createdAt        DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("media_processing_logs")
}

/// sha256 of files that must never be accepted again (MED-016).
model BannedMediaHash {
  sha256    String   @id @db.VarChar(64)
  reason    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("banned_media_hashes")
}

enum EmailTokenPurpose {
  ACCOUNT_EMAIL // prove control of User.email
  CLAIM_BUSINESS_EMAIL // reserved for M3-06 claim checks
}

/// ADR-0016. The web app inserts the row with tokenHash NULL; the worker generates the raw token, stores only
/// its SHA-256 hex digest, then mails it. Single use, 24 h expiry, bound to the target address.
model EmailVerificationToken {
  id            String            @id @default(cuid())
  userId        String
  purpose       EmailTokenPurpose
  email         String            @db.VarChar(254)
  claimId       String? // CLAIM_BUSINESS_EMAIL only: the claim this token verifies (m3b-spec 4.4)
  tokenHash     String?           @unique @db.Char(64)
  expiresAt     DateTime          @db.DateTime(3)
  sentAt        DateTime?         @db.DateTime(3)
  consumedAt    DateTime?         @db.DateTime(3)
  invalidatedAt DateTime?         @db.DateTime(3)
  createdAt     DateTime          @default(now()) @db.DateTime(3)

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim SellerOwnershipClaim? @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, purpose, createdAt])
  @@index([claimId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------------------------------------------
// M3-04: sellers, memberships, invitations, enforcement, ownership claims (docs/architecture/m3-sellers-spec.md §2).
// FKs on CHECK-carrying columns are Restrict/Restrict (MySQL ER 3823).
// ---------------------------------------------------------------------------------------------------------------

enum SellerStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  CLOSED
}

enum SellerMemberRole {
  OWNER
  MANAGER
  RESPONDER
}

enum OwnershipClaimScope {
  SELLER
  PRODUCT
}

enum OwnershipProofMethod {
  DNS_TXT
  META_TAG
  BUSINESS_EMAIL_DOMAIN
  DOCUMENT
  MARKETPLACE
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  CONTESTED
  EXPIRED
  REVOKED
  WITHDRAWN
}

enum ClaimEndReason {
  CHALLENGE_TIMEOUT
  INFO_TIMEOUT
  VALIDITY_ENDED
  REVERIFY_FAILED
  CONTEST_LOST
  SPOT_CHECK_FAILED
  STAFF_REVOKED
}

enum ClaimCheckOutcome {
  PASS
  NOT_FOUND
  MISMATCH
  FETCH_BLOCKED
  FETCH_ERROR
  DNS_ERROR
}

enum ClaimDecisionSource {
  RULE
  STAFF
}

enum ClaimDecisionOutcome {
  APPROVE
  REJECT
  REQUEST_INFO
  RENEW
  SPOT_CHECK_PASS
  SPOT_CHECK_FAIL
  REVOKE
}

enum EnforcementType {
  WARNING
  CONTENT_REMOVAL
  POSTING_RESTRICTION
  VOTING_RESTRICTION
  VERIFIED_LABEL_REVOKED
  SUSPENSION
  BAN
  SELLER_REPLY_RESTRICTION
  SELLER_SUSPENSION
}

enum EnforcementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  OVERTURNED
}

model Seller {
  id              String       @id @default(cuid())
  slug            String       @unique @db.VarChar(80)
  name            String       @db.VarChar(120)
  nameSkeleton    String       @db.VarChar(120)
  description     String?      @db.Text
  websiteUrl      String?      @db.VarChar(2048)
  countryCode     String?      @db.Char(2)
  status          SellerStatus @default(UNVERIFIED)
  verifiedClaimId String?
  verifiedDomain  String?      @db.VarChar(253)
  verifiedAt      DateTime?    @db.DateTime(3)
  nameReviewFlag  Boolean      @default(false)
  closedAt        DateTime?    @db.DateTime(3)
  createdById     String
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  createdBy     User                  @relation("SellerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// The verified claim must belong to this seller (composite FK, SEL-011).
  verifiedClaim SellerOwnershipClaim? @relation("SellerVerifiedClaim", fields: [verifiedClaimId, id], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)

  members            SellerMember[]
  invitations        SellerInvitation[]
  ownershipTransfers SellerOwnershipTransfer[]
  replies            SellerReply[]
  ownershipClaims    SellerOwnershipClaim[]    @relation("ClaimSeller")
  products           Product[]
  enforcementActions EnforcementAction[]

  @@unique([verifiedClaimId, id])
  @@index([status])
  @@index([nameSkeleton])
  @@map("sellers")
}

/// Accepted membership only. Pending invitations live in SellerInvitation. At least one OWNER per seller (service).
model SellerMember {
  sellerId     String
  userId       String
  role         SellerMemberRole
  invitationId String?          @unique
  createdAt    DateTime         @default(now()) @db.DateTime(3)
  updatedAt    DateTime         @updatedAt @db.DateTime(3)

  seller     Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user       User              @relation("SellerMembership", fields: [userId], references: [id], onDelete: Cascade)
  invitation SellerInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@id([sellerId, userId])
  @@index([userId])
  @@index([sellerId, role])
  @@map("seller_members")
}

/// SEL-007: 7-day, single-use, bound to the invitee's verified email. M3a roles: MANAGER, RESPONDER only.
model SellerInvitation {
  id           String           @id @default(cuid())
  sellerId     String
  email        String           @db.VarChar(254)
  role         SellerMemberRole
  tokenHash    String?          @unique @db.Char(64)
  invitedById  String
  expiresAt    DateTime         @db.DateTime(3)
  sentAt       DateTime?        @db.DateTime(3)
  acceptedAt   DateTime?        @db.DateTime(3)
  acceptedById String?
  revokedAt    DateTime?        @db.DateTime(3)
  revokedById  String?
  createdAt    DateTime         @default(now()) @db.DateTime(3)

  seller     Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy  User          @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy User?         @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy  User?         @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member     SellerMember?

  @@index([sellerId, email])
  @@index([expiresAt])
  @@map("seller_invitations")
}

model SellerOwnershipClaim {
  id                   String               @id @default(cuid())
  sellerId             String
  scope                OwnershipClaimScope
  productId            String?
  method               OwnershipProofMethod
  status               ClaimStatus          @default(PENDING)
  domain               String?              @db.VarChar(253)
  challengeValue       String?              @unique @db.VarChar(64)
  challengeExpiresAt   DateTime?            @db.DateTime(3)
  evidenceUrl          String?              @db.VarChar(2048)
  businessEmail        String?              @db.VarChar(254) // BUSINESS_EMAIL_DOMAIN only (chk_claim_business_email_*); personal data, never audited
  requiresHumanReview  Boolean              @default(false)
  humanReviewReason    String?              @db.VarChar(32)
  requiredApprovals    Int                  @default(1)
  conflictClaimId      String?
  contestResponseDueAt DateTime?            @db.DateTime(3)
  infoRequestedAt      DateTime?            @db.DateTime(3)
  checkAttempts        Int                  @default(0)
  lastCheckAt          DateTime?            @db.DateTime(3)
  lastCheckOutcome     ClaimCheckOutcome?
  nextCheckAt          DateTime?            @db.DateTime(3)
  spotCheckRequired    Boolean              @default(false)
  spotCheckedAt        DateTime?            @db.DateTime(3)
  verifiedAt           DateTime?            @db.DateTime(3)
  verifiedUntil        DateTime?            @db.DateTime(3)
  renewalRequestedAt   DateTime?            @db.DateTime(3)
  reverifyFailingSince DateTime?            @db.DateTime(3)
  graceEndsAt          DateTime?            @db.DateTime(3)
  endedAt              DateTime?            @db.DateTime(3)
  endReason            ClaimEndReason?
  activeKey            String?              @unique @db.VarChar(320)
  verifiedDomainKey    String?              @unique @db.VarChar(253)
  submittedById        String
  createdAt            DateTime             @default(now()) @db.DateTime(3)
  updatedAt            DateTime             @updatedAt @db.DateTime(3)

  seller        Seller                 @relation("ClaimSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product       Product?               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy   User                   @relation("ClaimSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  conflictClaim SellerOwnershipClaim?  @relation("ClaimConflict", fields: [conflictClaimId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conflictedBy  SellerOwnershipClaim[] @relation("ClaimConflict")
  verifiedFor   Seller?                @relation("SellerVerifiedClaim")

  decisions   SellerClaimDecision[]
  emailTokens EmailVerificationToken[]

  @@unique([id, sellerId])
  @@index([status, createdAt])
  @@index([sellerId, status])
  @@index([status, nextCheckAt])
  @@index([status, graceEndsAt])
  @@index([status, verifiedUntil])
  @@index([domain])
  @@index([productId])
  @@map("seller_ownership_claims")
}

/// Append-only decision log for a claim.
model SellerClaimDecision {
  id         String               @id @default(cuid())
  claimId    String
  source     ClaimDecisionSource
  reviewerId String?
  outcome    ClaimDecisionOutcome
  reasonCode String?              @db.VarChar(64)
  note       String?              @db.Text
  createdAt  DateTime             @default(now()) @db.DateTime(3)

  claim    SellerOwnershipClaim @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer User?                @relation("ClaimDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([claimId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("seller_claim_decisions")
}

model EnforcementAction {
  id                 String            @id @default(cuid())
  type               EnforcementType
  status             EnforcementStatus @default(ACTIVE)
  subjectUserId      String?
  subjectSellerId    String?
  subjectReviewId    String?
  caseId             String?
  reasonCode         String            @db.VarChar(64)
  publicReason       String            @db.Text
  publicReasonLocale String            @default("en") @db.VarChar(16)
  internalNote       String?           @db.Text
  issuedById         String?
  startsAt           DateTime          @default(now()) @db.DateTime(3)
  endsAt             DateTime?         @db.DateTime(3)
  revokedById        String?
  revokedAt          DateTime?         @db.DateTime(3)
  createdAt          DateTime          @default(now()) @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @db.DateTime(3)

  subjectUser    User?           @relation("EnforcementSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectSeller  Seller?         @relation(fields: [subjectSellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectReview  Review?         @relation("EnforcementSubjectReview", fields: [subjectReviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  issuedBy       User?           @relation("EnforcementIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy      User?           @relation("EnforcementRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([subjectUserId, status])
  @@index([subjectSellerId, status])
  @@index([subjectReviewId, type, status])
  @@index([status, endsAt])
  @@map("enforcement_actions")
}

/// Server-side state for one Auth.js JWT (claim `sid`). The JWT is only a carrier; this row is the session (ADR-0019).
model UserSession {
  id                     String    @id @default(cuid())
  userId                 String
  secondFactorPending    Boolean   @default(false)
  pendingExpiresAt       DateTime? @db.DateTime(3) // createdAt + 10 min while pending
  twoFactorFailures      Int       @default(0) // per-session cap 5 (chk_session_failures)
  secondFactorVerifiedAt DateTime? @db.DateTime(3)
  secondFactorMethod     String?   @db.VarChar(16) // TOTP | RECOVERY_CODE
  authTime               DateTime  @db.DateTime(3)
  reauthenticatedAt      DateTime? @db.DateTime(3) // step-up, valid 10 min
  successorId            String?   @unique // rotation pointer (m3b-spec 2.4)
  successorClaimedAt     DateTime? @db.DateTime(3)
  absoluteExpiresAt      DateTime  @db.DateTime(3)
  lastSeenAt             DateTime  @default(now()) @db.DateTime(3)
  revokedAt              DateTime? @db.DateTime(3)
  revokeReason           String?   @db.VarChar(32)
  ipHash                 String?   @db.Char(64)
  userAgent              String?   @db.VarChar(512)
  createdAt              DateTime  @default(now()) @db.DateTime(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  successor   UserSession? @relation("SessionRotation", fields: [successorId], references: [id], onDelete: SetNull)
  predecessor UserSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("user_sessions")
}

/// One row per user. Active secret (confirmed) and an optional pending replacement live side by side.
model TwoFactorTotp {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secretCiphertext        Bytes?    @db.VarBinary(255) // AES-256-GCM iv|ct|tag, AAD "totp|<userId>|<id>"
  keyId                   String?   @db.VarChar(64)
  confirmedAt             DateTime? @db.DateTime(3)
  lastUsedStep            BigInt? // replay guard
  pendingSecretCiphertext Bytes?    @db.VarBinary(255)
  pendingKeyId            String?   @db.VarChar(64)
  pendingExpiresAt        DateTime? @db.DateTime(3) // enrolment start + 15 min
  createdAt               DateTime  @default(now()) @db.DateTime(3)
  updatedAt               DateTime  @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pendingExpiresAt])
  @@map("two_factor_totps")
}

/// 10 per user, 60-bit codes. codeHash = hex HMAC-SHA-256(pepper[keyId], normalized code).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.Char(64)
  keyId     String    @db.VarChar(64)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------------------------------------------
// M3b-05: delayed two-party ownership changes (docs/architecture/m3b-spec.md section 3, ADR-0020).
// ---------------------------------------------------------------------------------------------------------------

enum OwnershipTransferKind {
  ADD_OWNER // target member becomes an additional OWNER; initiator stays OWNER
  TRANSFER // target becomes OWNER; initiator steps down (initiatorOutcome)
  REMOVE_OWNER // another OWNER is demoted or removed (targetOutcome); no acceptance, cancellable by the target
}

enum OwnershipTransferStatus {
  PENDING // waiting for the target's acceptance (ADD_OWNER/TRANSFER)
  ACCEPTED // accepted (REMOVE_OWNER starts here); waiting for executeAfter
  COMPLETED // terminal
  CANCELLED // terminal
  EXPIRED // terminal: not accepted before acceptBy
  FAILED // terminal: a precondition no longer held at execution
}

enum OwnerChangeOutcome {
  REMAIN_OWNER
  BECOME_MANAGER
  BECOME_RESPONDER
  REMOVED
}

enum OwnershipTransferEndReason {
  CANCELLED_BY_INITIATOR
  CANCELLED_BY_OWNER
  CANCELLED_BY_TARGET
  CANCELLED_BY_LINK
  CANCELLED_BY_STAFF
  CANCELLED_MEMBERSHIP_CHANGED
  INITIATOR_NOT_OWNER
  TARGET_NOT_ELIGIBLE
  TWO_FACTOR_MISSING
  SELLER_BLOCKED
  LAST_OWNER
}

model SellerOwnershipTransfer {
  id               String                      @id @default(cuid())
  sellerId         String
  kind             OwnershipTransferKind
  status           OwnershipTransferStatus     @default(PENDING)
  initiatorId      String
  targetUserId     String
  initiatorOutcome OwnerChangeOutcome          @default(REMAIN_OWNER)
  targetOutcome    OwnerChangeOutcome? // REMOVE_OWNER only
  openKey          String?                     @unique @db.VarChar(32) // = sellerId while PENDING/ACCEPTED
  executeAfter     DateTime                    @db.DateTime(3) // createdAt + 72 h; DB floor chk_transfer_delay
  acceptBy         DateTime                    @db.DateTime(3) // createdAt + 7 d
  acceptedAt       DateTime?                   @db.DateTime(3)
  endedAt          DateTime?                   @db.DateTime(3)
  endReason        OwnershipTransferEndReason?
  endedById        String?
  createdAt        DateTime                    @default(now()) @db.DateTime(3)
  updatedAt        DateTime                    @updatedAt @db.DateTime(3)

  seller       Seller                      @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiator    User                        @relation("TransferInitiator", fields: [initiatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  target       User                        @relation("TransferTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endedBy      User?                       @relation("TransferEndedBy", fields: [endedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelTokens SellerTransferCancelToken[]

  @@index([sellerId, createdAt])
  @@index([status, executeAfter])
  @@index([status, acceptBy])
  @@index([targetUserId, status])
  @@map("seller_ownership_transfers")
}

/// Single-use cancel link per recipient (every OWNER, plus the target). The raw token is generated by the worker; only SHA-256 is stored.
model SellerTransferCancelToken {
  id          String    @id @default(cuid())
  transferId  String
  recipientId String
  tokenHash   String?   @unique @db.Char(64)
  sentAt      DateTime? @db.DateTime(3)
  usedAt      DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  transfer  SellerOwnershipTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient User                    @relation("TransferCancelRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transferId, recipientId])
  @@map("seller_transfer_cancel_tokens")
}

model SellerReply {
  id          String        @id @default(cuid())
  reviewId    String
  sellerId    String // = product.sellerId at creation; scope source for authz (P-2)
  authorId    String
  body        String        @db.Text // plain text, <= 1500 chars (chk_reply_body_len)
  version     Int           @default(1) // bumped on edit; ModerationCase(sellerReplyId, version)
  status      ContentStatus @default(PENDING)
  publishedAt DateTime?     @db.DateTime(3)
  editedAt    DateTime?     @db.DateTime(3)
  deletedAt   DateTime?     @db.DateTime(3)
  deletedById String?
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)

  review    Review           @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seller    Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User             @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User?            @relation("ReplyDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cases     ModerationCase[]
  reports   Report[]

  @@unique([reviewId, sellerId])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("seller_replies")
}

// ---------------------------------------------------------------------------------------------------------------------
// M4 (m4-m5-spec 12.3): votes, reports, Verified Buyer proof
// ---------------------------------------------------------------------------------------------------------------------

enum VoteValue {
  HELPFUL
  NOT_HELPFUL
}

enum ReportReason {
  SPAM
  FAKE_OR_MISLEADING
  CONFLICT_OF_INTEREST
  OFF_TOPIC
  HARASSMENT_OR_HATE
  SEXUAL_CONTENT
  VIOLENCE_OR_THREATS
  PERSONAL_INFORMATION
  INTELLECTUAL_PROPERTY
  ILLEGAL_CONTENT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  NO_ACTION
  REJECTED
}

enum PurchaseProofMethod {
  RECEIPT_UPLOAD
  ORDER_CONFIRMATION
  MARKETPLACE_ORDER_LINK
}

enum ProofStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ProofCloseReason {
  DRAFT_ABANDONED
  SLA_EXPIRED
  NO_VALID_FILES
  USER_WITHDRAWN
}

enum ProofDecisionReason {
  UNREADABLE
  NOT_A_PURCHASE_DOCUMENT
  PRODUCT_MISMATCH
  MERCHANT_UNVERIFIABLE
  DATE_INVALID
  DUPLICATE_PROOF
  SUSPECTED_FORGERY
  OTHER
}

enum ProofRedactionMode {
  AUTO
  FULL_MASK
}

enum Marketplace {
  AMAZON
  EBAY
  ETSY
  OTHER
}

enum ProofFileStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
  FAILED
  PURGED
}

enum TrustSignalType {
  MALWARE_UPLOAD
  DUPLICATE_PROOF_DETECTED
  VERIFIED_PURCHASE
  PROOF_REJECTED_FRAUD
}

model ReviewVote {
  reviewId  String
  userId    String
  value     VoteValue
  ipHash    String?   @db.Char(64)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  user   User   @relation("ReviewVoter", fields: [userId], references: [id], onDelete: Restrict)

  @@id([reviewId, userId])
  @@index([userId, createdAt])
  @@map("review_votes")
}

model Report {
  id            String       @id @default(cuid())
  reporterId    String
  reason        ReportReason
  details       String?      @db.VarChar(1000)
  status        ReportStatus @default(OPEN)
  weight        Int          @default(1) @db.TinyInt // 0 for NEW reporters (F-9)
  caseId        String?
  reviewId      String? // exclusive arc (chk_report_one_target)
  sellerReplyId String?
  ipHash        String?      @db.Char(64)
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  resolvedAt    DateTime?    @db.DateTime(3)
  resolvedById  String?

  reporter       User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  review         Review?         @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerReply    SellerReply?    @relation(fields: [sellerReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy     User?           @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([reporterId, reviewId])
  @@unique([reporterId, sellerReplyId])
  @@index([caseId, status])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model PurchaseProof {
  id                     String               @id @default(cuid())
  reviewId               String
  submittedById          String
  method                 PurchaseProofMethod
  marketplace            Marketplace?
  status                 ProofStatus          @default(DRAFT)
  openKey                String?              @unique @db.VarChar(32) // = reviewId while DRAFT/PENDING
  consentVersion         String               @db.VarChar(16)
  consentedAt            DateTime             @db.DateTime(3)
  submittedAt            DateTime?            @db.DateTime(3)
  slaDueAt               DateTime?            @db.DateTime(3)
  filesReadyAt           DateTime?            @db.DateTime(3)
  redactionMode          ProofRedactionMode?
  redactedAt             DateTime?            @db.DateTime(3)
  assessedAt             DateTime?            @db.DateTime(3)
  aiAssessment           Json? // proofAssessment schema only
  flags                  Json? // ProofFlag[]
  merchantName           String?              @db.VarChar(120)
  purchaseDate           DateTime?            @db.Date
  orderReferenceHash     String?              @db.Char(64)
  orderReferenceKeyId    Int?                 @db.TinyInt
  fileFingerprint        String?              @db.Char(64)
  reviewedById           String?
  reviewedAt             DateTime?            @db.DateTime(3)
  decisionReasonCode     ProofDecisionReason?
  decisionNote           String?              @db.VarChar(500) // staff-only, no PII by policy
  closeReason            ProofCloseReason?
  closedAt               DateTime?            @db.DateTime(3)
  originalPurgedAt       DateTime?            @db.DateTime(3)
  filesDeleteRequestedAt DateTime?            @db.DateTime(3)
  filesPurgedAt          DateTime?            @db.DateTime(3)
  retainFilesUntil       DateTime?            @db.DateTime(3)
  legalHold              Boolean              @default(false)
  createdAt              DateTime             @default(now()) @db.DateTime(3)
  updatedAt              DateTime             @updatedAt @db.DateTime(3)

  review         Review              @relation("ReviewProofs", fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy    User                @relation("ProofSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy     User?               @relation("ProofReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  files          PurchaseProofFile[]
  verifiedReview Review?             @relation("ReviewVerifiedProof")

  @@index([status, filesReadyAt, slaDueAt])
  @@index([reviewId, status])
  @@index([submittedById, createdAt])
  @@index([orderReferenceHash])
  @@index([fileFingerprint])
  @@index([retainFilesUntil])
  @@map("purchase_proofs")
}

/// Evidence files of a proof. M4 keeps these apart from `media_assets` (public review media); the M5 media-core task folds
/// them into the reworked MediaAsset (purpose PURCHASE_PROOF). Originals live only in the private bucket and are never
/// served to staff; staff see the redacted derivatives (`isRedacted`, `derivedFromId`).
model PurchaseProofFile {
  id             String          @id @default(cuid())
  proofId        String
  ownerId        String
  kind           String          @db.VarChar(16) // IMAGE | DOCUMENT
  status         ProofFileStatus @default(UPLOADING)
  declaredMime   String          @db.VarChar(64)
  detectedMime   String?         @db.VarChar(64)
  sizeBytes      Int
  storageKey     String          @unique @db.VarChar(255)
  sha256         String?         @db.Char(64)
  perceptualHash String?         @db.VarChar(32)
  pageCount      Int?            @db.TinyInt
  isRedacted     Boolean         @default(false)
  derivedFromId  String?
  failureReason  String?         @db.VarChar(64)
  purgedAt       DateTime?       @db.DateTime(3)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)

  proof       PurchaseProof       @relation(fields: [proofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner       User                @relation("ProofFileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  derivedFrom PurchaseProofFile?  @relation("ProofFileDerivation", fields: [derivedFromId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivatives PurchaseProofFile[] @relation("ProofFileDerivation")

  @@index([proofId, status])
  @@index([sha256])
  @@map("purchase_proof_files")
}

/// Append-only trust events (scoring is M7). Written exactly once per source (TRS-008).
model TrustSignal {
  id         BigInt          @id @default(autoincrement())
  type       TrustSignalType
  userId     String          @db.VarChar(32)
  sourceType String          @db.VarChar(32)
  sourceId   String          @db.VarChar(32)
  createdAt  DateTime        @default(now()) @db.DateTime(3)

  @@unique([type, sourceType, sourceId, userId])
  @@index([userId, createdAt])
  @@map("trust_signals")
}
