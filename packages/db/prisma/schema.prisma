enum DecisionSource {
  AI
  RULE
  HUMAN
}

enum DecisionOutcome {
  APPROVE
  RESTRICT
  REMOVE
  ESCALATE
}

enum AppealStatus {
  SUBMITTED
  IN_REVIEW
  UPHELD
  OVERTURNED
  PARTIALLY_OVERTURNED
  WITHDRAWN
}

enum ModerationConfigStatus {
  DRAFT
  SHADOW
  ACTIVE
  RETIRED
}

enum ApprovalKind {
  CONFIG_ACTIVATION
  ROLE_GRANT
  TWO_FACTOR_RESET
  ENFORCEMENT_OVERTURN_MAJOR
  BREAK_GLASS_REPEAT
}

enum ApprovalStatus {
  PENDING
  EXECUTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BulkItemResult {
  PENDING
  APPLIED
  SKIPPED
  FAILED
}

model ModerationDecision {
  id                 String             @id @default(cuid())
  caseId             String
  transition         String             @db.VarChar(8) // "T6", "R4", "A4", "T4r"
  contentVersion     Int
  source             DecisionSource
  moderatorId        String? // = HUMAN actor
  outcome            DecisionOutcome
  verdict            ModerationVerdict?
  reasonCode         String?            @db.VarChar(64)
  publicReason       String?            @db.Text // statement of reasons (REJECT/REMOVE)
  publicReasonLocale String             @default("en") @db.VarChar(16)
  labels             Json? // category -> score
  ruleHits           Json? // rule ids only
  rationale          String?            @db.VarChar(280) // provider display text, escaped on render
  policyVersion      String             @db.VarChar(32)
  configVersion      String?            @db.VarChar(32)
  aiProvider         String?            @db.VarChar(64)
  aiModel            String?            @db.VarChar(128)
  failureCode        String?            @db.VarChar(32) // timeout|http_5xx|http_429|network|schema|unsupported_language|breaker|lost_job
  latencyMs          Int?
  bulkOperationId    String?            @db.VarChar(32)
  approvalRequestId  String?
  createdAt          DateTime           @db.DateTime(3) // from clock.now()

  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  moderator      User?          @relation("DecisionModerator", fields: [moderatorId], references: [id], onDelete: Restrict, onUpdate: Restrict) // MySQL error 3823: chk_decision_human forbids a cascading FK action on moderatorId

  @@index([caseId, createdAt])
  @@index([moderatorId, createdAt])
  @@index([bulkOperationId])
  @@map("moderation_decisions")
}

model Appeal {
  id                  String       @id @default(cuid())
  appellantId         String
  caseId              String? // exclusive arc (chk_appeal_one_target)
  enforcementActionId String?
  purchaseProofId     String?
  ownershipClaimId    String?
  contentVersion      Int? // AP-2
  statement           String       @db.Text
  status              AppealStatus @default(SUBMITTED)
  reviewerId          String?
  leaseExpiresAt      DateTime?    @db.DateTime(3)
  decisionNote        String?      @db.Text
  priority            Int          @default(0)
  slaDueAt            DateTime     @db.DateTime(3)
  submittedAt         DateTime     @db.DateTime(3) // from clock.now()
  decidedAt           DateTime?    @db.DateTime(3)
  updatedAt           DateTime     @updatedAt @db.DateTime(3)

  appellant         User                  @relation("AppealAppellant", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewer          User?                 @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  moderationCase    ModerationCase?       @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  enforcementAction EnforcementAction?    @relation(fields: [enforcementActionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseProof     PurchaseProof?        @relation(fields: [purchaseProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownershipClaim    SellerOwnershipClaim? @relation(fields: [ownershipClaimId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evidence          MediaAsset[]          @relation("AppealEvidence") // MediaAsset.appealId (new nullable FK)

  @@unique([appellantId, caseId])
  @@unique([appellantId, enforcementActionId])
  @@unique([appellantId, purchaseProofId])
  @@unique([appellantId, ownershipClaimId])
  @@index([status, priority, slaDueAt])
  @@index([reviewerId, status])
  @@map("appeals")
}

model ModerationConfig {
  id            String                 @id @default(cuid())
  version       String                 @unique @db.VarChar(32)
  status        ModerationConfigStatus @default(DRAFT)
  config        Json
  checksum      String                 @db.Char(64)
  note          String?                @db.Text
  createdById   String
  activatedById String?
  approvedById  String? // four-eyes approver (CFG-004)
  activatedAt   DateTime?              @db.DateTime(3)
  retiredAt     DateTime?              @db.DateTime(3)
  createdAt     DateTime               @db.DateTime(3)

  @@index([status])
  @@map("moderation_configs")
}

model StaffApprovalRequest {
  id            String         @id @default(cuid())
  kind          ApprovalKind
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  targetKey     String         @db.VarChar(80) // "role:<userId>:<role>", "config:<version>", "2fa:<userId>", "appeal:<id>", "bg:<submitterId>"
  openKey       String?        @unique @db.VarChar(80) // = targetKey while PENDING
  payload       Json // ids/enums/numbers only
  payloadHash   String         @db.Char(64)
  note          String?        @db.VarChar(500)
  expiresAt     DateTime       @db.DateTime(3)
  decidedAt     DateTime?      @db.DateTime(3)
  executedAt    DateTime?      @db.DateTime(3)
  createdAt     DateTime       @db.DateTime(3)
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, expiresAt])
  @@index([kind, status])
  @@map("staff_approval_requests")
}

model BreakGlassAccess {
  id                String        @id @default(cuid())
  staffId           String
  sessionId         String        @db.VarChar(64)
  proofId           String
  fileId            String
  submitterId       String // for the 7-day repeat rule
  reasonCode        String        @db.VarChar(32)
  reasonText        String        @db.VarChar(500)
  approvalRequestId String?
  expiresAt         DateTime      @db.DateTime(3)
  usedAt            DateTime?     @db.DateTime(3)
  createdAt         DateTime      @db.DateTime(3)
  staff             User          @relation("BreakGlassStaff", fields: [staffId], references: [id], onDelete: Restrict)
  proof             PurchaseProof @relation(fields: [proofId], references: [id], onDelete: Restrict)

  @@index([staffId, createdAt])
  @@index([submitterId, createdAt])
  @@map("break_glass_accesses")
}

model BulkOperation {
  id            String              @id @default(cuid())
  requestedById String
  lane          ModerationLane
  action        String              @db.VarChar(16)
  reasonCode    String?             @db.VarChar(64)
  publicReason  String?             @db.Text
  size          Int
  createdAt     DateTime            @db.DateTime(3)
  completedAt   DateTime?           @db.DateTime(3)
  items         BulkOperationItem[]

  @@map("moderation_bulk_operations")
}

model BulkOperationItem {
  bulkOperationId String
  caseId          String
  result          BulkItemResult @default(PENDING)
  reason          String?        @db.VarChar(32) // resolved|leased|coi|legal_hold|invalid_transition
  bulk            BulkOperation  @relation(fields: [bulkOperationId], references: [id], onDelete: Cascade)

  @@id([bulkOperationId, caseId])
  @@map("moderation_bulk_items")
}

model TrustScoreSnapshot {
  id              String    @id @default(cuid())
  subjectUserId   String?   @db.VarChar(32)
  subjectSellerId String?   @db.VarChar(32)
  score           Decimal   @db.Decimal(5, 2)
  band            TrustBand
  algorithmVersion String   @db.VarChar(32)
  components      Json
  computedAt      DateTime  @db.DateTime(3)

  @@index([subjectUserId, computedAt])
  @@index([subjectSellerId, computedAt])
  @@map("trust_score_snapshots")
}

model ReviewFingerprint {
  reviewId  String
  version   Int
  minhash   Bytes    @db.VarBinary(512)
  createdAt DateTime @db.DateTime(3)

  @@id([reviewId, version])
  @@map("review_fingerprints")
}

model ReviewLshBucket {
  band      Int      @db.TinyInt
  bucket    String   @db.Char(16)
  reviewId  String
  authorId  String
  createdAt DateTime @db.DateTime(3)

  @@id([band, bucket, reviewId])
  @@index([reviewId])
  @@map("review_lsh_buckets")
}

model ProductBurst {
  id             String   @id @default(cuid())
  productId      String
  startedAt      DateTime @db.DateTime(3)
  lastReviewAt   DateTime @db.DateTime(3)
  endsAt         DateTime @db.DateTime(3)
  reviewCount    Int
  lowTrustCount  Int

  @@index([productId, endsAt])
  @@map("product_bursts")
}

model Follow {
  id                String           @id @default(cuid())
  followerId        String
  targetType        FollowTargetType
  followedUserId    String?
  followedSellerId  String?
  followedProductId String?
  createdAt         DateTime         @default(now()) @db.DateTime(3)

  follower     User  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedUser User? @relation("FollowedUser", fields: [followedUserId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedUserId])
  @@unique([followerId, followedSellerId])
  @@unique([followerId, followedProductId])
  @@index([followedUserId])
  @@index([followedSellerId])
  @@index([followedProductId])
  @@map("follows")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.DateTime(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  entityType  String?          @db.VarChar(50)
  entityId    String?          @db.VarChar(191)
  data        Json?
  groupKey    String           @db.VarChar(191)
  readAt      DateTime?        @db.DateTime(3)
  emailedAt   DateTime?        @db.DateTime(3)
  createdAt   DateTime         @default(now()) @db.DateTime(3)

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, groupKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  userId  String
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

/// ADR-0033 / spec 22.2: account erasure is a tracked, resumable job. `steps` holds ISO completion times per step;
/// `completedAt` is set only after every purge verified (HEAD 404).
model ErasureRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  requestedAt DateTime  @db.DateTime(3)
  steps       Json
  completedAt DateTime? @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([completedAt])
  @@map("erasure_requests")
}

/// Presentation of one image in a product gallery (ADR-0034 D11). Bytes, scan and moderation live on MediaAsset (purpose = PRODUCT_IMAGE).
/// CHECKs and the generated `primaryProductId` column live in the migration SQL.
model ProductImage {
  id            String    @id @default(cuid())
  productId     String
  mediaAssetId  String    @unique
  /// Store-neutral public key of the display master WITHOUT extension ("m/<assetId>/medium"); equals the Cloudinary public_id. NULL until promoted.
  publicId      String?   @db.VarChar(255)
  format        String    @default("webp") @db.VarChar(8)
  width         Int?
  height        Int?
  /// Hex "#rrggbb" for a no-CLS placeholder background (optional).
  dominantColor String?   @db.Char(7)
  /// Required plain text, <= 250 chars (alt text is mandatory, task #103).
  alt           String    @db.VarChar(250)
  position      Int       @default(0) @db.SmallInt
  isPrimary     Boolean   @default(false)
  /// Stored generated column (CASE WHEN isPrimary THEN productId END) + UNIQUE: at most one primary per product. Never written by the app.
  primaryProductId String? @unique @db.VarChar(191)
  /// Set by media.promote when the asset goes public; cleared by demote. Public reads require it.
  publishedAt   DateTime? @db.DateTime(3)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("ProductImageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, publishedAt, position])
  @@map("product_images")
}

enum ReviewSummaryStatus {
  READY
  HIDDEN
  FAILED
}

/// AI-generated pros/cons/summary of a product's PUBLISHED reviews (ADR-0034 D12). One row per (product, language); regenerated, never versioned.
/// CHECKs live in the migration SQL.
model ProductReviewSummary {
  id                String              @id @default(cuid())
  productId         String
  language          String              @default("en") @db.VarChar(16)
  status            ReviewSummaryStatus @default(READY)
  /// JSON arrays of 3..5 plain-text strings, each <= 120 chars, validated by zod before write.
  pros              Json
  cons              Json
  summary           String              @db.VarChar(600)
  sourceReviewCount Int
  /// IDs of the reviews used as input (<= 50).
  sourceReviewIds   Json
  /// sha256 of the sorted "reviewId:publishedVersion" input list; same hash -> no regeneration.
  inputHash         String              @db.Char(64)
  model             String              @db.VarChar(64)
  promptSha256      String              @db.Char(64)
  generatedAt       DateTime            @db.DateTime(3)
  hiddenAt          DateTime?           @db.DateTime(3)
  hiddenReason      String?             @db.VarChar(32)
  hiddenById        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  hiddenBy User?   @relation("ReviewSummaryHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@unique([productId, language])
  @@map("product_review_summaries")
}
