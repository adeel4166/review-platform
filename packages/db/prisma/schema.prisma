model EnforcementAction {
  appeals            Appeal[]
  strike             Boolean           @default(false)
  decisionId         String?
  appealableUntil    DateTime?         @db.DateTime(3)
  id                 String            @id @default(cuid())
  type               EnforcementType
  status             EnforcementStatus @default(ACTIVE)
