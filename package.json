{
  "name": "review-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:local": "bash scripts/local-up.sh",
    "infra:up": "docker compose up -d --wait mysql redis minio mailpit && docker compose --profile init run --rm minio-init",
    "infra:down": "docker compose down",
    "dev": "pnpm --parallel --filter @rp/web --filter @rp/worker dev",
    "db:generate": "pnpm --filter @rp/db generate",
    "db:push": "pnpm --filter @rp/db push",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "design:check": "node design/gen.cjs && git diff --exit-code design/tokens.css design/tailwind-preset.cjs && node design/check-contrast.cjs",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm design:check",
    "coverage": "pnpm --filter @rp/core --filter @rp/worker --filter @rp/web exec vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "^0.41.3",
      "postcss": "^8.5.23",
      "effect": "^3.22.1",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
