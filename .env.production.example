# Production variable NAMES for docker-compose.prod.yml. Values here are placeholders only; real values come from the secret manager
# and are injected as environment (never committed, never printed). `CHANGE_ME` values must all be replaced before a real deploy.
DATABASE_URL=mysql://CHANGE_ME:CHANGE_ME@mysql.internal:3306/review_platform
APP_URL=https://reviews.example.com
REDIS_DEFAULT_PASSWORD=CHANGE_ME
REDIS_VERIF_EGRESS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
RP_CORE_KEY=CHANGE_ME
RP_CORE_SECRET=CHANGE_ME
RP_MEDIA_KEY=CHANGE_ME
RP_MEDIA_SECRET=CHANGE_ME
RP_WEB_KEY=CHANGE_ME
RP_WEB_SECRET=CHANGE_ME
MODERATION_PROVIDER=anthropic
MODERATION_API_KEY=CHANGE_ME
IP_HASH_KEY=CHANGE_ME
AUTH_SECRET=CHANGE_ME
TOTP_ENC_KEYS=CHANGE_ME
TOTP_ENC_ACTIVE_KEY_ID=CHANGE_ME
RECOVERY_CODE_PEPPERS=CHANGE_ME
RECOVERY_CODE_ACTIVE_KEY_ID=CHANGE_ME
SMTP_URL=CHANGE_ME
MAIL_FROM=noreply@example.com
S3_BUCKET_LEDGER=rp-ledger
VERIFY_DNS_SERVERS=1.1.1.1,8.8.8.8
MEDIA_PUBLIC_BASE_URL=https://media.example.com

# SEC-FIN-02 / SEC-FIN-03 (names only; values from the secret store). Object-locked buckets rp-ledger and rp-audit-archive are created by minio-init.
S3_BUCKET_AUDIT_ARCHIVE=rp-audit-archive
S3_LEDGER_ACCESS_KEY_ID=CHANGE_ME
S3_LEDGER_SECRET_ACCESS_KEY=CHANGE_ME
S3_LEDGER_READ_ACCESS_KEY_ID=CHANGE_ME
S3_LEDGER_READ_SECRET_ACCESS_KEY=CHANGE_ME
S3_AUDIT_ARCHIVE_ACCESS_KEY_ID=CHANGE_ME
S3_AUDIT_ARCHIVE_SECRET_ACCESS_KEY=CHANGE_ME
# Separate DB role for the audit archive (INSERT-only app grant on audit_logs is set up per the DB runbook)
ARCHIVE_DATABASE_URL=mysql://CHANGE_ME:CHANGE_ME@mysql.internal:3306/review_platform_archive
LEDGER_RETENTION_DAYS=400
# SEC-FIN-01: MODERATION_PROVIDER=anthropic (the real provider). MODERATION_API_KEY is read from this env var only and never logged.
MODERATION_MODEL=claude-haiku-5-5
MODERATION_DAILY_CAP=20000
