# Names-only template for docker-compose.staging.yml (CI renders the compose file with it). scripts/staging-up.sh GENERATES the real
# .env.staging (mode 600, gitignored) on first run; never put real values here. MODERATION_PROVIDER / MODERATION_API_KEY are supplied by
# the operator from the secret store (exported in the shell or added to .env.staging), never generated.
STAGING_HOST=localhost
WEB_PORT=3000
MINIO_PORT=9000
MAILPIT_UI_PORT=8025
APP_URL=http://localhost:3000
S3_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/rp-public
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_APP_PASSWORD=CHANGE_ME
REDIS_DEFAULT_PASSWORD=CHANGE_ME
REDIS_VERIF_EGRESS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
RP_CORE_KEY=CHANGE_ME
RP_CORE_SECRET=CHANGE_ME
RP_MEDIA_KEY=CHANGE_ME
RP_MEDIA_SECRET=CHANGE_ME
RP_WEB_KEY=CHANGE_ME
RP_WEB_SECRET=CHANGE_ME
S3_LEDGER_ACCESS_KEY_ID=CHANGE_ME
S3_LEDGER_SECRET_ACCESS_KEY=CHANGE_ME
S3_LEDGER_READ_ACCESS_KEY_ID=CHANGE_ME
S3_LEDGER_READ_SECRET_ACCESS_KEY=CHANGE_ME
S3_AUDIT_ARCHIVE_ACCESS_KEY_ID=CHANGE_ME
S3_AUDIT_ARCHIVE_SECRET_ACCESS_KEY=CHANGE_ME
IP_HASH_KEY=CHANGE_ME
AUTH_SECRET=CHANGE_ME
TOTP_ENC_KEYS=CHANGE_ME
TOTP_ENC_ACTIVE_KEY_ID=CHANGE_ME
RECOVERY_CODE_PEPPERS=CHANGE_ME
RECOVERY_CODE_ACTIVE_KEY_ID=CHANGE_ME
DEMO_PASSWORD=CHANGE_ME
STAGING_SEED_DEMO=1
# Optional HTTPS without a domain (compose profile "tls"): STAGING_TLS=1 makes staging-up.sh derive TLS_APP_HOST / TLS_S3_HOST (sslip.io) and https endpoints.
TLS_APP_HOST=app.invalid
TLS_S3_HOST=s3.invalid
MODERATION_PROVIDER=CHANGE_ME
MODERATION_API_KEY=CHANGE_ME
